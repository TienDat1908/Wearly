<section class="max-w-7xl mx-auto px-5 py-16">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-pink-100 text-pink-700 text-sm font-black">
        ✨ <%= t("app.tagline") %>
      </div>

      <h1 class="mt-6 text-5xl md:text-7xl font-black tracking-tight leading-[0.95]">
        <%= t("home.hero_title") %>
      </h1>

      <p class="mt-6 text-lg text-slate-600 max-w-xl">
        <%= t("home.hero_subtitle") %>
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <%= link_to t("home.explore_now"), products_path, class: "px-7 py-4 rounded-full bg-slate-950 text-white font-black shadow-xl shadow-slate-300" %>

        <% if user_signed_in? && (current_user.owner? || current_user.admin?) %>
          <%= link_to owner_bookings_path, class: "relative px-7 py-4 rounded-full bg-white border border-pink-200 text-slate-950 font-black shadow-sm" do %>
            <%= t("home.booking_requests") %>

            <% if @owner_pending_bookings_count.to_i.positive? %>
              <span class="ml-2 inline-flex min-w-6 h-6 px-2 rounded-full bg-pink-500 text-white text-xs items-center justify-center">
                <%= @owner_pending_bookings_count %>
              </span>
            <% end %>
          <% end %>

          <%= link_to t("home.list_your_item"), owner_products_path, class: "px-7 py-4 rounded-full bg-white border border-slate-200 font-black" %>
        <% elsif !user_signed_in? %>
          <%= link_to t("home.list_your_item"), new_user_registration_path(role: "owner"), class: "px-7 py-4 rounded-full bg-white border border-slate-200 font-black" %>
        <% end %>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -inset-4 rounded-[3rem] bg-gradient-to-br from-pink-200 via-orange-100 to-yellow-100 rotate-3"></div>

      <div class="relative rounded-[3rem] bg-white p-5 shadow-2xl">
        <div class="aspect-[4/5] rounded-[2.5rem] bg-gradient-to-br from-pink-400 via-orange-300 to-yellow-200 flex items-center justify-center">
          <div class="text-center text-white">
            <div class="text-8xl mb-5">👗</div>
            <p class="text-3xl font-black">Outfits • Cameras • Moments</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-5 pb-16">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-3xl font-black"><%= t("home.latest_products") %></h2>
    <%= link_to t("home.view_all"), products_path, class: "font-black text-pink-600" %>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% @featured_products.each do |product| %>
      <%= render "products/product_card", product: product %>
    <% end %>
  </div>
</section>
