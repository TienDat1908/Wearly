<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-pink-600 font-black uppercase tracking-wide">
        <%= t("admin.payouts.payout_reference", id: @payout.id) %>
      </p>
      <h2 class="mt-2 text-3xl font-black">
        <%= @payout.owner.full_name.presence || @payout.owner.email %>
      </h2>
    </div>

    <span class="px-4 py-2 rounded-full text-xs font-black <%= @payout.pending? ? 'bg-orange-50 text-orange-600' : 'bg-green-50 text-green-700' %>">
      <%= t("admin.payouts.statuses.#{@payout.status}") %>
    </span>
  </div>

  <div class="grid lg:grid-cols-[1fr_360px] gap-6">
    <div class="space-y-6">
      <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
        <h3 class="text-xl font-black mb-5"><%= t("admin.payouts.booking_details") %></h3>

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold">Booking ID</p>
            <%= link_to "##{@payout.booking.id}", admin_booking_path(@payout.booking), class: "mt-2 block font-black text-pink-600" %>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.bookings.product") %></p>
            <%= link_to @payout.booking.product.title, admin_product_path(@payout.booking.product), class: "mt-2 block font-black text-pink-600" %>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.bookings.renter") %></p>
            <%= link_to (@payout.booking.renter.full_name.presence || @payout.booking.renter.email), admin_user_path(@payout.booking.renter), class: "mt-2 block font-black text-pink-600" %>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.bookings.status") %></p>
            <p class="mt-2 font-black"><%= booking_status_label(@payout.booking) %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.bookings.total") %></p>
            <p class="mt-2 font-black"><%= number_to_currency(@payout.booking.total_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.payouts.completed_at") %></p>
            <p class="mt-2 font-black"><%= @payout.booking.completed_at ? l(@payout.booking.completed_at, format: :long) : "-" %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
        <h3 class="text-xl font-black mb-5"><%= t("admin.payouts.owner_details") %></h3>

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.users.user") %></p>
            <%= link_to (@payout.owner.full_name.presence || @payout.owner.email), admin_user_path(@payout.owner), class: "mt-2 block font-black text-pink-600" %>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold">Email</p>
            <p class="mt-2 font-black break-all"><%= @payout.owner.email %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.users.phone") %></p>
            <p class="mt-2 font-black"><%= @payout.owner.phone.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.users.address") %></p>
            <p class="mt-2 font-black"><%= [@payout.owner.address, @payout.owner.ward, @payout.owner.district, @payout.owner.city].compact_blank.join(", ").presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("profile.bank_name") %></p>
            <p class="mt-2 font-black"><%= @payout.owner.bank_name.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("profile.bank_account_name") %></p>
            <p class="mt-2 font-black"><%= @payout.owner.bank_account_name.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4 sm:col-span-2">
            <p class="text-sm text-slate-500 font-bold"><%= t("profile.bank_account_number") %></p>
            <p class="mt-2 font-black"><%= @payout.owner.bank_account_number.presence || "-" %></p>
          </div>
        </div>
      </div>
    </div>

    <aside class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm h-fit">
      <h3 class="text-xl font-black"><%= t("admin.payouts.payout_summary") %></h3>

      <div class="mt-6 space-y-4">
        <div class="flex justify-between gap-4">
          <span class="text-slate-300"><%= t("admin.bookings.rental_amount") %></span>
          <span class="font-black"><%= number_to_currency(@payout.booking.rental_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-slate-300"><%= t("products.cleaning_fee") %></span>
          <span class="font-black"><%= number_to_currency(@payout.booking.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-slate-300"><%= t("admin.bookings.owner_fee_short", rate: Booking::OWNER_PLATFORM_FEE_RATE) %></span>
          <span class="font-black text-pink-300">- <%= number_to_currency(@payout.booking.platform_fee_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="border-t border-white/10 pt-4 flex justify-between gap-4">
          <span class="text-slate-300"><%= t("admin.bookings.owner_payout") %></span>
          <span class="text-2xl font-black text-pink-300"><%= number_to_currency(@payout.amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="border-t border-white/10 pt-4 space-y-3">
          <div class="flex justify-between gap-4">
            <span class="text-slate-300"><%= t("admin.payouts.status") %></span>
            <span class="font-black"><%= t("admin.payouts.statuses.#{@payout.status}") %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300">Method</span>
            <span class="font-black"><%= @payout.payout_method.presence || "-" %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300">Created</span>
            <span class="font-black text-right"><%= l(@payout.created_at, format: :long) %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300">Updated</span>
            <span class="font-black text-right"><%= l(@payout.updated_at, format: :long) %></span>
          </div>
        </div>

        <% if @payout.admin_note.present? %>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-xs text-slate-400 font-black uppercase tracking-widest">Admin note</p>
            <p class="mt-2 font-bold whitespace-pre-line"><%= @payout.admin_note %></p>
          </div>
        <% end %>

        <% if @payout.paid_at.present? %>
          <div class="rounded-2xl bg-green-500/10 text-green-300 p-4 font-black text-center">
            <%= t("admin.payouts.paid_at", time: l(@payout.paid_at, format: :long)) %>
          </div>
        <% elsif @payout.pending? %>
          <%= form_with model: [:admin, @payout], method: :patch, local: true, class: "space-y-3" do |f| %>
            <%= f.text_area :admin_note,
              rows: 3,
              placeholder: t("admin.payouts.admin_note_placeholder"),
              class: "w-full rounded-2xl bg-white/10 border-white/10 text-white placeholder:text-slate-400" %>

            <%= f.submit t("admin.payouts.mark_paid"), class: "w-full py-4 rounded-2xl bg-pink-500 text-white font-black cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </aside>
  </div>
</div>
