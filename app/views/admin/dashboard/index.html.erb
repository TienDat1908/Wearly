<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5">
  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.total_users") %></p>
    <p class="mt-3 text-4xl font-black"><%= @users_count %></p>

    <div class="mt-4 flex gap-2 text-xs font-black">
      <span class="px-3 py-1 rounded-full bg-pink-50 text-pink-600">
        <%= @owners_count %> <%= t("admin.dashboard.owners") %>
      </span>

      <span class="px-3 py-1 rounded-full bg-orange-50 text-orange-600">
        <%= @renters_count %> <%= t("admin.dashboard.renters") %>
      </span>
    </div>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.total_products") %></p>
    <p class="mt-3 text-4xl font-black"><%= @products_count %></p>
    <p class="mt-2 text-sm text-orange-500 font-bold">
      + <%= t("admin.dashboard.marketplace") %>
    </p>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.total_bookings") %></p>
    <p class="mt-3 text-4xl font-black"><%= @bookings_count %></p>
    <p class="mt-2 text-sm text-blue-500 font-bold">
      + <%= t("admin.dashboard.transactions") %>
    </p>
  </div>

  <div class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm">
    <p class="text-sm font-bold text-slate-300"><%= t("admin.dashboard.pending_bookings") %></p>
    <p class="mt-3 text-4xl font-black"><%= @pending_bookings_count %></p>
    <p class="mt-2 text-sm text-pink-300 font-bold">
      + <%= t("admin.dashboard.needs_review") %>
    </p>
  </div>
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-8">
  <div class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm">
    <p class="text-sm font-bold text-slate-300"><%= t("admin.dashboard.gmv") %></p>

    <p class="mt-3 text-3xl font-black">
      <%= number_to_currency(@gmv_amount, unit: "₫", precision: 0, format: "%n %u") %>
    </p>

    <p class="mt-2 text-sm text-pink-300 font-bold">
      <%= t("admin.dashboard.total_transaction_value") %>
    </p>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.platform_revenue") %></p>

    <p class="mt-3 text-3xl font-black text-pink-600">
      <%= number_to_currency(@platform_revenue_amount, unit: "₫", precision: 0, format: "%n %u") %>
    </p>

    <p class="mt-2 text-sm text-slate-500 font-bold">
      <%= t("admin.dashboard.owner_fee") %> <%= @owner_platform_fee_rate %>%
      +
      <%= t("admin.dashboard.renter_fee") %> <%= @renter_service_fee_rate %>%
    </p>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.pending_payouts") %></p>

    <p class="mt-3 text-3xl font-black">
      <%= number_to_currency(@pending_payouts_amount, unit: "₫", precision: 0, format: "%n %u") %>
    </p>

    <p class="mt-2 text-sm text-orange-500 font-bold">
      <%= @pending_payouts_count %> <%= t("admin.dashboard.needs_payout") %>
    </p>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <p class="text-sm font-bold text-slate-500"><%= t("admin.dashboard.deposit_held") %></p>

    <p class="mt-3 text-3xl font-black">
      <%= number_to_currency(@deposit_amount, unit: "₫", precision: 0, format: "%n %u") %>
    </p>

    <p class="mt-2 text-sm text-blue-500 font-bold">
      <%= t("admin.dashboard.not_platform_revenue") %>
    </p>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-6 mt-8">
  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black"><%= t("admin.dashboard.revenue_breakdown") %></h2>

      <span class="px-3 py-1 rounded-full bg-pink-50 text-pink-600 text-xs font-black">
        <%= t("admin.dashboard.platform_revenue") %>
      </span>
    </div>

    <div class="space-y-6">
      <div>
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class="font-black"><%= t("admin.dashboard.owner_fee") %></p>
            <p class="text-sm text-slate-500 font-bold">
              <%= @owner_platform_fee_rate %>% <%= t("admin.dashboard.deducted_from_owner") %>
            </p>
          </div>

          <p class="font-black text-pink-600">
            <%= number_to_currency(@owner_platform_fee_amount, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>

        <div class="h-3 rounded-full bg-slate-100 overflow-hidden">
          <div
            class="h-full rounded-full bg-pink-500"
            style="width: <%= @platform_revenue_amount.positive? ? [(@owner_platform_fee_amount.to_f / @platform_revenue_amount * 100).round, 100].min : 0 %>%">
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class="font-black"><%= t("admin.dashboard.renter_fee") %></p>
            <p class="text-sm text-slate-500 font-bold">
              <%= @renter_service_fee_rate %>% <%= t("admin.dashboard.charged_to_renter") %>
            </p>
          </div>

          <p class="font-black text-orange-500">
            <%= number_to_currency(@renter_service_fee_amount, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>

        <div class="h-3 rounded-full bg-slate-100 overflow-hidden">
          <div
            class="h-full rounded-full bg-orange-400"
            style="width: <%= @platform_revenue_amount.positive? ? [(@renter_service_fee_amount.to_f / @platform_revenue_amount * 100).round, 100].min : 0 %>%">
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-slate-50 p-4">
        <div class="flex items-center justify-between">
          <p class="font-black"><%= t("admin.dashboard.total_platform_revenue") %></p>

          <p class="font-black text-pink-600">
            <%= number_to_currency(@platform_revenue_amount, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black"><%= t("admin.dashboard.business_model") %></h2>
      <span class="text-2xl">💸</span>
    </div>

    <div class="space-y-4">
      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-slate-300 text-sm font-bold"><%= t("admin.dashboard.owner_side") %></p>
        <p class="mt-1 font-black">
          <%= t("admin.dashboard.owner_side_desc", rate: @owner_platform_fee_rate) %>
        </p>
      </div>

      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-slate-300 text-sm font-bold"><%= t("admin.dashboard.renter_side") %></p>
        <p class="mt-1 font-black">
          <%= t("admin.dashboard.renter_side_desc", rate: @renter_service_fee_rate) %>
        </p>
      </div>

      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-slate-300 text-sm font-bold"><%= t("admin.dashboard.deposit_note") %></p>
        <p class="mt-1 font-black">
          <%= t("admin.dashboard.deposit_note_desc") %>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="grid xl:grid-cols-3 gap-6 mt-8">
  <div class="xl:col-span-2 bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black"><%= t("admin.dashboard.latest_bookings") %></h2>
      <%= link_to t("admin.actions.view_all"), admin_bookings_path, class: "text-sm font-black text-pink-600" %>
    </div>

    <div class="space-y-3">
      <% @latest_bookings.each do |booking| %>
        <%= link_to admin_booking_path(booking), class: "flex items-center justify-between gap-4 rounded-2xl bg-slate-50 p-4 hover:bg-pink-50 transition" do %>
          <div>
            <p class="font-black"><%= booking.product.title %></p>

            <p class="text-sm text-slate-500">
              <%= booking.renter.full_name.presence || booking.renter.email %>
              →
              <%= booking.owner.full_name.presence || booking.owner.email %>
            </p>

            <p class="mt-1 text-xs text-slate-400 font-bold">
              <%= t("admin.dashboard.platform_fee") %>:
              <%= number_to_currency(booking.platform_fee_amount.to_i + (booking.respond_to?(:renter_service_fee_amount) ? booking.renter_service_fee_amount.to_i : 0), unit: "₫", precision: 0, format: "%n %u") %>
            </p>
          </div>

          <div class="text-right">
            <p class="font-black text-pink-600">
              <%= number_to_currency(booking.gmv_amount, unit: "₫", precision: 0, format: "%n %u") %>
            </p>

            <p class="text-xs font-black uppercase text-slate-500">
              <%= booking_status_label(booking) %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black"><%= t("admin.dashboard.latest_users") %></h2>
      <%= link_to t("admin.actions.view_all"), admin_users_path, class: "text-sm font-black text-pink-600" %>
    </div>

    <div class="space-y-3">
      <% @latest_users.each do |user| %>
        <%= link_to admin_user_path(user), class: "flex items-center gap-3 rounded-2xl bg-slate-50 p-4 hover:bg-pink-50 transition" do %>
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black">
            <%= user.full_name.to_s.first.presence || "U" %>
          </div>

          <div>
            <p class="font-black"><%= user.full_name.presence || user.email %></p>
            <p class="text-sm text-slate-500"><%= user.role %> • <%= user.status %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100 mt-8">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-xl font-black"><%= t("admin.dashboard.latest_products") %></h2>
    <%= link_to t("admin.actions.view_all"), admin_products_path, class: "text-sm font-black text-pink-600" %>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
    <% @latest_products.each do |product| %>
      <%= link_to admin_product_path(product), class: "rounded-[1.5rem] bg-slate-50 p-3 hover:bg-pink-50 transition" do %>
        <div class="aspect-[4/5] rounded-[1.25rem] bg-white overflow-hidden">
          <% if product.photos.attached? %>
            <%= image_tag product.photos.first, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-5xl bg-gradient-to-br from-pink-100 to-orange-100">
              ✨
            </div>
          <% end %>
        </div>

        <p class="mt-3 font-black line-clamp-1"><%= product.title %></p>
        <p class="text-sm text-slate-500"><%= product.status %></p>
      <% end %>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100 mt-8">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-xl font-black"><%= t("admin.dashboard.latest_payouts") %></h2>
    <%= link_to t("admin.actions.view_all"), admin_payouts_path, class: "text-sm font-black text-pink-600" %>
  </div>

  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% @latest_payouts.each do |payout| %>
      <%= link_to admin_payout_path(payout), class: "block rounded-2xl bg-slate-50 p-4 hover:bg-pink-50 transition" do %>
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="font-black"><%= payout.owner.full_name.presence || payout.owner.email %></p>
            <p class="mt-1 text-sm text-slate-500"><%= payout.booking.product.title %></p>
          </div>

          <span class="px-3 py-1 rounded-full text-xs font-black <%= payout.pending? ? 'bg-orange-50 text-orange-600' : 'bg-green-50 text-green-700' %>">
            <%= t("admin.payouts.statuses.#{payout.status}") %>
          </span>
        </div>

        <p class="mt-4 text-xl font-black text-pink-600">
          <%= number_to_currency(payout.amount.to_i, unit: "₫", precision: 0, format: "%n %u") %>
        </p>
      <% end %>
    <% end %>

    <% if @latest_payouts.empty? %>
      <p class="text-slate-500 font-bold"><%= t("admin.payouts.empty") %></p>
    <% end %>
  </div>
</div>
