<% preview_images = @home_spotlight.display_images.first(5) %>

<div class="max-w-[92rem]">
  <div class="mb-10 overflow-hidden rounded-[2.25rem] border border-slate-200 bg-white shadow-sm">
    <div class="relative p-7 lg:p-9">
      <div class="absolute right-0 top-0 h-44 w-96 rounded-bl-[5rem] bg-gradient-to-br from-pink-100 via-orange-50 to-transparent"></div>

      <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-pink-500"><%= t("admin.home_spotlight.label") %></p>
          <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950"><%= t("admin.home_spotlight.title") %></h2>
          <p class="mt-3 text-lg font-bold leading-8 text-slate-500"><%= t("admin.home_spotlight.subtitle") %></p>
        </div>

        <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-950 text-lg text-white">✨</span>
          <div>
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400"><%= t("admin.home_spotlight.active") %></p>
            <p class="font-black text-slate-950"><%= @home_spotlight.active? ? t("admin.nav.live") : t("admin.home_spotlight.hidden") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= form_with model: @home_spotlight,
    url: admin_home_spotlight_path,
    method: :patch,
    local: true,
    html: { multipart: true, data: { controller: "home-spotlight-preview" } },
    class: "grid items-start gap-10 xl:grid-cols-[minmax(0,1fr)_450px]" do |f| %>

    <div class="space-y-10">
      <section class="overflow-hidden rounded-[2.25rem] border border-slate-200 bg-white shadow-sm">
        <div class="flex items-start justify-between gap-4 border-b border-slate-100 bg-slate-50/60 px-7 py-6">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-slate-400">01 · <%= t("admin.home_spotlight.images") %></p>
            <h3 class="mt-1 text-2xl font-black text-slate-950"><%= t("admin.home_spotlight.trend_board") %></h3>
          </div>
          <span class="rounded-full bg-pink-50 px-4 py-2 text-sm font-black text-pink-500"><%= preview_images.size %> / 5</span>
        </div>

        <div class="space-y-7 p-7">
          <div class="grid gap-5 md:grid-cols-3">
            <div class="rounded-[1.5rem] border border-pink-100 bg-pink-50 p-5">
              <p class="text-2xl">🔥</p>
              <p class="mt-3 font-black text-slate-950"><%= t("admin.home_spotlight.rank_one") %></p>
              <p class="mt-1 text-sm font-bold leading-6 text-slate-500"><%= t("admin.home_spotlight.rank_one_hint") %></p>
            </div>

            <div class="rounded-[1.5rem] border border-orange-100 bg-orange-50 p-5">
              <p class="text-2xl">🖼️</p>
              <p class="mt-3 font-black text-slate-950"><%= t("admin.home_spotlight.max_images") %></p>
              <p class="mt-1 text-sm font-bold leading-6 text-slate-500"><%= t("admin.home_spotlight.max_images_hint") %></p>
            </div>

            <div class="rounded-[1.5rem] border border-slate-100 bg-slate-50 p-5">
              <p class="text-2xl">↔️</p>
              <p class="mt-3 font-black text-slate-950"><%= t("admin.home_spotlight.preview") %></p>
              <p class="mt-1 text-sm font-bold leading-6 text-slate-500"><%= t("admin.home_spotlight.image_hint") %></p>
            </div>
          </div>

          <div class="rounded-[2rem] border border-pink-100 bg-gradient-to-br from-pink-50 to-orange-50 p-6">
            <%= f.label :images, t("admin.home_spotlight.images"), class: "block font-black mb-3 text-slate-950" %>
            <div class="rounded-2xl border-2 border-dashed border-pink-200 bg-white/80 p-4">
              <%= f.file_field :images,
                multiple: true,
                accept: "image/png,image/jpeg,image/webp",
                class: "block w-full text-sm font-bold text-slate-600 file:mr-4 file:rounded-full file:border-0 file:bg-slate-950 file:px-5 file:py-3 file:font-black file:text-white",
                data: {
                  home_spotlight_preview_target: "imageInput",
                  action: "change->home-spotlight-preview#previewImage"
                } %>
            </div>
            <p class="mt-3 text-sm font-bold text-slate-500"><%= t("admin.home_spotlight.image_hint") %></p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-[2.25rem] border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 bg-slate-50/60 px-7 py-6">
          <p class="text-xs font-black uppercase tracking-widest text-slate-400">02 · <%= t("admin.home_spotlight.content") %></p>
          <h3 class="mt-1 text-2xl font-black text-slate-950"><%= t("admin.home_spotlight.headline") %></h3>
        </div>

        <div class="space-y-7 p-7">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <%= f.label :eyebrow, t("admin.home_spotlight.eyebrow"), class: "block font-black mb-2 text-slate-950" %>
              <%= f.text_field :eyebrow,
                class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-4 font-bold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
                data: {
                  home_spotlight_preview_target: "eyebrowInput",
                  action: "input->home-spotlight-preview#update"
                } %>
            </div>

            <div>
              <%= f.label :title, t("admin.home_spotlight.headline"), class: "block font-black mb-2 text-slate-950" %>
              <%= f.text_field :title,
                class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-4 font-bold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
                data: {
                  home_spotlight_preview_target: "titleInput",
                  action: "input->home-spotlight-preview#update"
                } %>
            </div>
          </div>

          <div>
            <%= f.label :subtitle, t("admin.home_spotlight.description"), class: "block font-black mb-2 text-slate-950" %>
            <%= f.text_area :subtitle,
              rows: 4,
              class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-4 font-bold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
              data: {
                home_spotlight_preview_target: "subtitleInput",
                action: "input->home-spotlight-preview#update"
              } %>
          </div>

          <div class="rounded-[1.5rem] border border-slate-100 bg-slate-50 p-5">
            <p class="text-2xl">✍️</p>
            <p class="mt-3 font-black text-slate-950"><%= t("admin.home_spotlight.admin_copy") %></p>
            <p class="mt-1 text-sm font-bold leading-6 text-slate-500"><%= t("admin.home_spotlight.admin_copy_hint") %></p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-[2.25rem] border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 bg-slate-50/60 px-7 py-6">
          <p class="text-xs font-black uppercase tracking-widest text-slate-400">03 · <%= t("admin.home_spotlight.active") %></p>
          <h3 class="mt-1 text-2xl font-black text-slate-950"><%= t("admin.home_spotlight.position") %></h3>
        </div>

        <div class="grid gap-6 p-7 md:grid-cols-[1fr_180px]">
          <label class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-black text-slate-950">
            <%= f.check_box :active,
              class: "rounded border-slate-300 text-pink-500 focus:ring-pink-400",
              data: {
                home_spotlight_preview_target: "activeInput",
                action: "change->home-spotlight-preview#update"
              } %>
            <%= t("admin.home_spotlight.active") %>
          </label>

          <div>
            <%= f.label :position, t("admin.home_spotlight.position"), class: "block font-black mb-2 text-slate-950" %>
            <%= f.number_field :position, min: 1, class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-4 font-bold text-slate-950 focus:border-pink-400 focus:ring-pink-400" %>
          </div>
        </div>
      </section>

      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-3 shadow-sm">
        <%= f.submit t("admin.actions.save"), class: "w-full cursor-pointer rounded-[1.35rem] bg-gradient-to-r from-pink-500 to-orange-400 px-6 py-4 font-black text-white shadow-xl shadow-pink-100 transition hover:-translate-y-0.5" %>
      </div>
    </div>

    <aside class="xl:sticky xl:top-28">
      <div class="overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950 p-4 text-white shadow-2xl shadow-slate-300">
        <div class="flex items-center justify-between gap-4 px-1 pb-4">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-pink-300"><%= t("admin.home_spotlight.preview") %></p>
            <p class="mt-1 text-sm font-bold text-slate-400"><%= t("admin.home_spotlight.preview_title") %></p>
          </div>

          <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-black text-emerald-300 ring-1 ring-emerald-300/20"
                data-home-spotlight-preview-target="status"
                data-active-label="<%= t("admin.nav.live") %>"
                data-inactive-label="<%= t("admin.home_spotlight.hidden") %>">
            <%= @home_spotlight.active? ? t("admin.nav.live") : t("admin.home_spotlight.hidden") %>
          </span>
        </div>

        <div class="overflow-hidden rounded-[1.75rem] bg-white p-3">
          <div class="relative overflow-hidden rounded-[1.35rem] bg-gradient-to-br from-pink-500 via-rose-400 to-orange-300 aspect-[4/5]">
            <div class="absolute inset-0" data-home-spotlight-preview-target="slideContainer">
              <% if preview_images.any? %>
                <% preview_images.each_with_index do |preview_image, index| %>
                  <div class="absolute inset-0 <%= "hidden" unless index.zero? %>" data-home-spotlight-preview-target="slide">
                    <%= image_tag preview_image, class: "h-full w-full object-cover" %>
                  </div>
                <% end %>
              <% else %>
                <div class="absolute inset-0 flex h-full items-center justify-center text-7xl" data-home-spotlight-preview-target="slide">👗</div>
              <% end %>
            </div>

            <button type="button"
                    class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-xl font-black text-slate-950 shadow-xl transition hover:scale-105 <%= "hidden" if preview_images.size <= 1 %>"
                    data-home-spotlight-preview-target="controls"
                    data-action="home-spotlight-preview#previous"
                    aria-label="Previous image">‹</button>

            <button type="button"
                    class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-pink-500 text-xl font-black text-white shadow-xl shadow-pink-500/30 transition hover:scale-105 <%= "hidden" if preview_images.size <= 1 %>"
                    data-home-spotlight-preview-target="controls"
                    data-action="home-spotlight-preview#next"
                    aria-label="Next image">›</button>

            <div class="absolute bottom-3 right-3 rounded-full bg-slate-950/90 px-3 py-1.5 text-xs font-black text-white"
                 data-home-spotlight-preview-target="counter">
              1 / <%= [preview_images.size, 1].max %>
            </div>

            <div class="absolute inset-x-0 bottom-4 flex justify-center gap-1.5 <%= "hidden" if preview_images.size <= 1 %>"
                 data-home-spotlight-preview-target="dotContainer">
              <% [preview_images.size, 1].max.times do |index| %>
                <button type="button"
                        class="h-2 rounded-full transition <%= index.zero? ? "w-5 bg-pink-500" : "w-2 bg-white/35" %>"
                        data-index="<%= index %>"
                        data-home-spotlight-preview-target="dot"
                        data-action="home-spotlight-preview#go"
                        aria-label="Preview image <%= index + 1 %>"></button>
              <% end %>
            </div>
          </div>

          <div class="mt-3 rounded-[1.35rem] bg-slate-50 p-4 text-slate-950">
            <p class="text-xs font-black uppercase tracking-widest text-pink-500" data-home-spotlight-preview-target="eyebrow" data-fallback="<%= t("home.featured_pick") %>"><%= @home_spotlight.eyebrow.presence || t("home.featured_pick") %></p>
            <h3 class="mt-2 text-2xl font-black leading-tight" data-home-spotlight-preview-target="title" data-fallback="<%= t("home.hero_float") %>"><%= @home_spotlight.title.presence || t("home.hero_float") %></h3>
            <p class="mt-2 text-sm font-bold leading-6 text-slate-500" data-home-spotlight-preview-target="subtitle" data-fallback="<%= t("home.curated_placeholder") %>"><%= @home_spotlight.subtitle.presence || t("home.curated_placeholder") %></p>
          </div>
        </div>
      </div>
    </aside>
  <% end %>
</div>
