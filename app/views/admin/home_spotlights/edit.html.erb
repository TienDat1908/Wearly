<% preview_images = @home_spotlight.display_images.first(5) %>

<div class="mx-auto max-w-6xl">
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <p class="text-[11px] font-black uppercase tracking-[0.24em] text-pink-500"><%= t("admin.home_spotlight.label") %></p>
      <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl"><%= t("admin.home_spotlight.title") %></h1>
      <p class="mt-1.5 max-w-2xl text-sm font-semibold leading-6 text-slate-500"><%= t("admin.home_spotlight.subtitle") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-slate-600">
        <%= preview_images.size %> / 5
      </span>
      <span class="rounded-full px-2.5 py-1 text-[11px] font-black uppercase tracking-wider <%= @home_spotlight.active? ? "bg-emerald-500 text-white" : "bg-slate-200 text-slate-600" %>">
        <%= @home_spotlight.active? ? t("admin.nav.live") : t("admin.home_spotlight.hidden") %>
      </span>
    </div>
  </header>

  <%= form_with model: @home_spotlight,
    url: admin_home_spotlight_path,
    method: :patch,
    local: true,
    html: { multipart: true, data: { controller: "home-spotlight-preview" } },
    class: "grid items-start gap-5 xl:grid-cols-[minmax(0,1fr)_340px]" do |f| %>

    <div class="space-y-4">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-3.5">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">01 · <%= t("admin.home_spotlight.images") %></p>
            <p class="mt-1 text-xs font-semibold text-slate-500"><%= t("admin.home_spotlight.image_hint") %></p>
          </div>
        </div>

        <div class="space-y-3 p-5">
          <label class="flex cursor-pointer items-center justify-between gap-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 transition hover:border-pink-300 hover:bg-pink-50/40">
            <span class="min-w-0">
              <span class="block text-sm font-black text-slate-950"><%= t("admin.home_spotlight.upload_cta") %></span>
              <span class="mt-0.5 block text-xs font-semibold text-slate-500"><%= t("admin.home_spotlight.upload_formats") %></span>
            </span>
            <%= f.file_field :images,
              multiple: true,
              accept: "image/png,image/jpeg,image/webp",
              class: "max-w-[14rem] text-xs font-semibold text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-950 file:px-3 file:py-2 file:text-xs file:font-black file:text-white",
              data: {
                home_spotlight_preview_target: "imageInput",
                action: "change->home-spotlight-preview#previewImage"
              } %>
          </label>

          <div class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2.5">
            <div class="flex items-center gap-2">
              <%= f.label :spin_frame_count, t("admin.home_spotlight.spin_frames"), class: "text-xs font-bold text-slate-500" %>
              <%= f.number_field :spin_frame_count,
                min: HomeSpotlight::MIN_SPIN_FRAMES,
                max: HomeSpotlight::MAX_SPIN_FRAMES,
                class: "w-16 rounded-lg border-slate-200 bg-slate-50 px-2 py-1.5 text-center text-sm font-semibold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
                data: { home_spotlight_preview_target: "frameInput" } %>
            </div>
            <p class="text-xs font-semibold text-slate-400"><%= t("admin.home_spotlight.spin_inline_hint") %></p>
          </div>

          <div class="grid grid-cols-5 gap-2" data-home-spotlight-preview-target="outfitGrid">
            <% if preview_images.any? %>
              <% preview_images.each_with_index do |image, index| %>
                <figure class="overflow-hidden rounded-xl border border-slate-200 bg-[linear-gradient(180deg,#fff,#f3f4f6)]">
                  <%= image_tag image,
                    class: "aspect-[3/4] w-full object-contain p-0.5",
                    alt: "",
                    data: (@home_spotlight.spin_enabled? ? { strip_preview: "true" } : {}) %>
                  <figcaption class="px-1 py-1 text-center text-[9px] font-black uppercase tracking-wider text-slate-400">
                    <%= t("admin.home_spotlight.look_n", number: index + 1) %>
                    <% if @home_spotlight.spin_enabled? %> · 360<% end %>
                  </figcaption>
                </figure>
              <% end %>
            <% else %>
              <div class="col-span-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-6 text-center text-xs font-semibold text-slate-500">
                <%= t("admin.home_spotlight.no_looks_yet") %>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-3.5">
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">02 · <%= t("admin.home_spotlight.content") %></p>
        </div>

        <div class="space-y-3.5 p-5">
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <%= f.label :eyebrow, t("admin.home_spotlight.eyebrow"), class: "mb-1.5 block text-xs font-black text-slate-950" %>
              <%= f.text_field :eyebrow,
                class: "w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
                data: {
                  home_spotlight_preview_target: "eyebrowInput",
                  action: "input->home-spotlight-preview#update"
                } %>
            </div>
            <div>
              <%= f.label :title, t("admin.home_spotlight.headline"), class: "mb-1.5 block text-xs font-black text-slate-950" %>
              <%= f.text_field :title,
                class: "w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
                data: {
                  home_spotlight_preview_target: "titleInput",
                  action: "input->home-spotlight-preview#update"
                } %>
            </div>
          </div>

          <div>
            <%= f.label :subtitle, t("admin.home_spotlight.description"), class: "mb-1.5 block text-xs font-black text-slate-950" %>
            <%= f.text_area :subtitle,
              rows: 2,
              class: "w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-950 focus:border-pink-400 focus:ring-pink-400",
              data: {
                home_spotlight_preview_target: "subtitleInput",
                action: "input->home-spotlight-preview#update"
              } %>
          </div>

          <div class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2.5">
            <label class="inline-flex items-center gap-2 text-sm font-bold text-slate-950">
              <%= f.check_box :active,
                class: "h-4 w-4 rounded border-slate-300 text-pink-500 focus:ring-pink-400",
                data: {
                  home_spotlight_preview_target: "activeInput",
                  action: "change->home-spotlight-preview#update"
                } %>
              <span><%= t("admin.home_spotlight.active") %></span>
            </label>

            <span class="hidden h-4 w-px bg-slate-200 sm:block" aria-hidden="true"></span>

            <div class="flex items-center gap-2">
              <%= f.label :position, t("admin.home_spotlight.position"), class: "text-xs font-bold text-slate-500" %>
              <%= f.number_field :position,
                min: 1,
                class: "w-16 rounded-lg border-slate-200 bg-slate-50 px-2 py-1.5 text-center text-sm font-semibold text-slate-950 focus:border-pink-400 focus:ring-pink-400" %>
            </div>
          </div>
        </div>
      </section>

      <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-semibold text-slate-400"><%= t("admin.home_spotlight.preview_note") %></p>
        <%= f.submit t("admin.actions.save"),
          class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-xs font-black uppercase tracking-[0.14em] text-white transition hover:bg-pink-500" %>
      </div>
    </div>

    <aside class="xl:sticky xl:top-20">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400"><%= t("admin.home_spotlight.preview") %></p>
            <p class="mt-0.5 text-sm font-bold text-slate-950"><%= t("admin.home_spotlight.preview_title") %></p>
          </div>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-600"
                data-home-spotlight-preview-target="status"
                data-active-label="<%= t("admin.nav.live") %>"
                data-inactive-label="<%= t("admin.home_spotlight.hidden") %>">
            <%= @home_spotlight.active? ? t("admin.nav.live") : t("admin.home_spotlight.hidden") %>
          </span>
        </div>

        <div class="bg-[#f7f7f5] p-3">
          <div class="relative overflow-hidden rounded-xl border border-slate-200/80 bg-white">
            <div class="relative aspect-[4/5]" data-home-spotlight-preview-target="slideContainer">
              <% if preview_images.any? %>
                <% preview_images.each_with_index do |preview_image, index| %>
                  <div class="absolute inset-0 flex items-end justify-center <%= "hidden" unless index.zero? %>" data-home-spotlight-preview-target="slide">
                    <%= image_tag preview_image,
                      class: "max-h-full w-auto max-w-[76%] object-contain object-bottom drop-shadow-xl",
                      alt: "",
                      data: (@home_spotlight.spin_enabled? ? { strip_preview: "true" } : {}) %>
                  </div>
                <% end %>
              <% else %>
                <div class="absolute inset-0 flex items-center justify-center text-xs font-bold text-slate-400" data-home-spotlight-preview-target="slide">
                  <%= t("admin.home_spotlight.preview_empty") %>
                </div>
              <% end %>
            </div>

            <div class="border-t border-slate-100 bg-white px-3 py-2.5">
              <p class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-400"
                 data-home-spotlight-preview-target="eyebrow"
                 data-fallback="<%= t("home.featured_pick") %>"><%= @home_spotlight.eyebrow.presence || t("home.featured_pick") %></p>
              <p class="mt-0.5 text-sm font-black uppercase tracking-tight text-slate-950"
                 data-home-spotlight-preview-target="title"
                 data-fallback="<%= t("home.hero_float") %>"><%= @home_spotlight.title.presence || t("home.hero_float") %></p>
              <p class="mt-0.5 line-clamp-2 text-[11px] font-semibold leading-4 text-slate-500"
                 data-home-spotlight-preview-target="subtitle"
                 data-fallback="<%= t("home.curated_placeholder") %>"><%= @home_spotlight.subtitle.presence || t("home.curated_placeholder") %></p>
            </div>
          </div>

          <div class="mt-2.5 flex items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1 <%= "hidden" if preview_images.size <= 1 %>"
                 data-home-spotlight-preview-target="dotContainer">
              <% preview_images.each_with_index do |thumb, index| %>
                <button type="button"
                        class="h-10 w-8 overflow-hidden rounded-md border <%= index.zero? ? "border-pink-500" : "border-slate-200" %>"
                        data-index="<%= index %>"
                        data-home-spotlight-preview-target="dot"
                        data-action="home-spotlight-preview#go"
                        aria-label="<%= t("home.spotlight_go_to", number: index + 1) %>">
                  <%= image_tag thumb,
                    class: "h-full w-full object-contain bg-white",
                    alt: "",
                    data: (@home_spotlight.spin_enabled? ? { strip_preview: "true" } : {}) %>
                </button>
              <% end %>
            </div>

            <p class="ml-auto text-[11px] font-black tabular-nums text-slate-400" data-home-spotlight-preview-target="counter">
              1 / <%= [preview_images.size, 1].max %>
            </p>
          </div>
        </div>
      </div>
    </aside>
  <% end %>
</div>
