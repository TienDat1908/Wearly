<div class="flex items-center justify-between mb-6">
  <div>
    <p class="text-pink-600 font-black uppercase tracking-wide"><%= @booking.status %></p>
    <h2 class="text-4xl font-black"><%= @booking.product.title %></h2>
    <p class="text-slate-500 mt-1">
      <%= @booking.renter.full_name.presence || @booking.renter.email %>
      →
      <%= @booking.owner.full_name.presence || @booking.owner.email %>
    </p>
  </div>

  <%= link_to t("admin.actions.edit"), edit_admin_booking_path(@booking), class: "px-5 py-3 rounded-full bg-slate-950 text-white font-black" %>
</div>

<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white rounded-[2rem] p-6 shadow-sm">
    <h3 class="text-xl font-black mb-5"><%= t("admin.bookings.details") %></h3>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl bg-slate-50 p-4">
        <p class="text-sm text-slate-500"><%= t("bookings.start_time") %></p>
        <p class="font-black"><%= l(@booking.start_time, format: :long) if @booking.start_time %></p>
      </div>

      <div class="rounded-2xl bg-slate-50 p-4">
        <p class="text-sm text-slate-500"><%= t("bookings.end_time") %></p>
        <p class="font-black"><%= l(@booking.end_time, format: :long) if @booking.end_time %></p>
      </div>

      <div class="rounded-2xl bg-slate-50 p-4">
        <p class="text-sm text-slate-500"><%= t("admin.bookings.rental_days") %></p>
        <p class="font-black"><%= @booking.rental_days %></p>
      </div>

      <div class="rounded-2xl bg-slate-50 p-4">
        <p class="text-sm text-slate-500"><%= t("admin.bookings.amount") %></p>
        <p class="font-black text-pink-600"><%= number_to_currency(@booking.total_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
      </div>
    </div>
  </div>

  <div class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm">
    <h3 class="text-xl font-black mb-5"><%= t("admin.bookings.payment_summary") %></h3>

    <div class="space-y-4">
      <div class="flex justify-between">
        <span class="text-slate-300"><%= t("admin.bookings.rental_amount") %></span>
        <span class="font-black"><%= number_to_currency(@booking.rental_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-300"><%= t("products.cleaning_fee") %></span>
        <span class="font-black"><%= number_to_currency(@booking.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-300"><%= t("products.deposit") %></span>
        <span class="font-black"><%= number_to_currency(@booking.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
      </div>

      <div class="pt-4 border-t border-white/10 flex justify-between">
        <span class="text-slate-300"><%= t("admin.bookings.total") %></span>
        <span class="font-black text-pink-300"><%= number_to_currency(@booking.total_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
      </div>
    </div>
  </div>
</div>
