<% full_address = [@product.address, @product.ward, @product.district, @product.city].compact_blank.join(", ") %>

<div class="space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
    <div>
      <p class="text-pink-600 font-black uppercase tracking-wide">
        <%= @product.product_type %> · PRODUCT #<%= @product.id %>
      </p>
      <h2 class="mt-2 text-4xl font-black"><%= @product.title %></h2>
      <p class="text-slate-500 mt-1">
        <%= link_to (@product.owner.full_name.presence || @product.owner.email), admin_user_path(@product.owner), class: "hover:text-pink-600 font-bold" %>
      </p>
    </div>

    <%= link_to t("admin.actions.edit"), edit_admin_product_path(@product), class: "px-5 py-3 rounded-full bg-slate-950 text-white font-black" %>
  </div>

  <div class="grid xl:grid-cols-[1fr_420px] gap-6">
    <div class="space-y-6">
      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("products.form.photos") %></h3>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% if @product.photos.attached? %>
            <% @product.photo_gallery.each_with_index do |photo, index| %>
              <div class="relative">
                <%= image_tag photo, class: "rounded-[2rem] w-full aspect-[4/5] object-cover bg-slate-100 #{index.zero? ? "ring-4 ring-pink-200" : ""}" %>
                <% if index.zero? %>
                  <span class="absolute left-3 top-3 rounded-full bg-pink-500 px-3 py-1 text-xs font-black text-white">
                    <%= t("products.cover_photo") %>
                  </span>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="sm:col-span-2 lg:col-span-3 rounded-[2rem] aspect-[16/8] bg-gradient-to-br from-pink-100 to-orange-100 flex items-center justify-center text-8xl">✨</div>
          <% end %>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.products.details") %></h3>

        <div class="grid md:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("admin.products.status") %></p>
            <p class="font-black"><%= @product.status %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.type") %></p>
            <p class="font-black"><%= @product.product_type.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.condition_status") %></p>
            <p class="font-black"><%= @product.condition_status.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.size") %></p>
            <p class="font-black"><%= @product.size.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.color") %></p>
            <p class="font-black"><%= @product.color.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.brand") %></p>
            <p class="font-black"><%= @product.brand.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.gender") %></p>
            <p class="font-black"><%= @product.gender.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.age_group") %></p>
            <p class="font-black"><%= @product.age_group.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("admin.products.photo_count") %></p>
            <p class="font-black"><%= @product.photos.count %></p>
          </div>
        </div>

        <div class="mt-5 rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= t("products.form.description") %></p>
          <p class="font-semibold mt-2 whitespace-pre-line"><%= @product.description.presence || "-" %></p>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("profile.address_info") %></h3>

        <div class="grid md:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-slate-50 p-4 md:col-span-3">
            <p class="text-sm text-slate-500"><%= t("admin.users.address") %></p>
            <p class="font-black"><%= full_address.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.ward") %></p>
            <p class="font-black"><%= @product.ward.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.district") %></p>
            <p class="font-black"><%= @product.district.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("products.form.city") %></p>
            <p class="font-black"><%= @product.city.presence || "-" %></p>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.products.extra_details") %></h3>

        <% if @product.details.present? %>
          <div class="rounded-2xl bg-slate-950 text-white p-5 overflow-auto">
            <pre class="text-sm font-semibold whitespace-pre-wrap"><%= JSON.pretty_generate(@product.details) %></pre>
          </div>
        <% else %>
          <p class="rounded-2xl bg-slate-50 p-4 font-black">-</p>
        <% end %>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.products.activity") %></h3>

        <div class="grid md:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("admin.nav.bookings") %></p>
            <p class="mt-2 text-3xl font-black"><%= @product.bookings.count %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold">Reservations</p>
            <p class="mt-2 text-3xl font-black"><%= @product.product_reservations.count %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold">Reviews</p>
            <p class="mt-2 text-3xl font-black"><%= @product.reviews.count %></p>
          </div>
        </div>

        <div class="mt-4 rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500 font-bold"><%= t("admin.dashboard.latest_bookings") %></p>
          <div class="mt-3 space-y-2">
            <% @product.bookings.includes(:renter).order(created_at: :desc).limit(6).each do |booking| %>
              <%= link_to "##{booking.id} · #{booking_status_label(booking)} · #{booking.renter.full_name.presence || booking.renter.email}", admin_booking_path(booking), class: "block font-black text-pink-600" %>
            <% end %>
            <p class="font-black"><%= "-" if @product.bookings.none? %></p>
          </div>
        </div>
      </section>
    </div>

    <aside class="space-y-6">
      <section class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.bookings.payment_summary") %></h3>

        <div class="space-y-4">
          <div class="flex justify-between gap-4">
            <span class="text-slate-300"><%= t("products.rental_price") %></span>
            <span class="font-black"><%= number_to_currency(@product.price_per_day.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300"><%= t("products.deposit") %></span>
            <span class="font-black"><%= number_to_currency(@product.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300"><%= t("products.cleaning_fee") %></span>
            <span class="font-black"><%= number_to_currency(@product.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
          </div>

          <div class="flex justify-between gap-4">
            <span class="text-slate-300"><%= t("products.form.replacement_value") %></span>
            <span class="font-black"><%= number_to_currency(@product.replacement_value.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("bookings.pickup_method") %></h3>

        <div class="grid gap-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("bookings.self_pickup") %></p>
            <p class="font-black"><%= @product.pickup_available? ? "Yes" : "No" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("bookings.delivery") %></p>
            <p class="font-black"><%= @product.delivery_available? ? "Yes" : "No" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("bookings.pickup_return_location") %></p>
            <p class="font-black"><%= @product.pickup_location.presence || "-" %></p>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.bookings.owner") %></h3>

        <div class="space-y-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("admin.users.user") %></p>
            <%= link_to (@product.owner.full_name.presence || @product.owner.email), admin_user_path(@product.owner), class: "font-black text-pink-600" %>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= t("admin.users.phone") %></p>
            <p class="font-black"><%= @product.owner.phone.presence || "-" %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500">Email</p>
            <p class="font-black break-all"><%= @product.owner.email.presence || "-" %></p>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-xl font-black mb-5"><%= t("admin.users.system_info") %></h3>

        <div class="space-y-4">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500">Created at</p>
            <p class="font-black"><%= l(@product.created_at, format: :long) %></p>
          </div>

          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500">Updated at</p>
            <p class="font-black"><%= l(@product.updated_at, format: :long) %></p>
          </div>
        </div>
      </section>
    </aside>
  </div>
</div>
