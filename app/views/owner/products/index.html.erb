<section class="max-w-7xl mx-auto px-5 py-10">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-4xl font-black"><%= t("owner.products.title") %></h1>
      <p class="text-slate-500 mt-2"><%= t("owner.products.subtitle") %></p>
    </div>

    <%= link_to t("nav.list_item"), new_owner_product_path, class: "px-5 py-3 rounded-full bg-slate-950 text-white font-black" %>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% @products.each do |product| %>
      <div class="bg-white rounded-[2rem] p-4 shadow-sm">
        <div class="aspect-[4/5] rounded-[1.5rem] bg-slate-100 overflow-hidden">
          <% if product.cover_photo.present? %>
            <%= image_tag product.cover_photo, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-6xl bg-gradient-to-br from-pink-100 to-orange-100">
              ✨
            </div>
          <% end %>
        </div>

        <h3 class="mt-4 font-black text-lg"><%= product.title %></h3>
        <p class="text-sm text-slate-500"><%= product.status %></p>

        <p class="mt-2 font-black text-pink-600">
          <%= number_to_currency(product.price_per_day, unit: "₫", precision: 0, format: "%n %u") %>
        </p>

        <div class="flex gap-2 mt-4">
          <%= link_to t("actions.edit"), edit_owner_product_path(product), class: "px-4 py-2 rounded-full bg-slate-100 font-black" %>
          <% unless product.inactive? %>
            <%= button_to t("actions.archive"), owner_product_path(product), method: :delete, class: "px-4 py-2 rounded-full bg-red-50 text-red-600 font-black" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
