<section class="wearly-page">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="wearly-eyebrow"><%= t("nav.manage") %></p>
      <h1 class="wearly-title"><%= t("owner.products.title") %></h1>
      <p class="wearly-subtitle"><%= t("owner.products.subtitle") %></p>
    </div>

    <%= link_to t("nav.list_item"), new_owner_product_path, class: "wearly-btn wearly-btn-primary" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% @products.each do |product| %>
      <article class="flex h-full flex-col overflow-hidden rounded-[2rem] bg-[#f7f2ec] shadow-[0_18px_50px_rgba(0,0,0,0.35)]">
        <div class="aspect-[4/5] overflow-hidden bg-slate-200">
          <% if product.cover_photo.present? %>
            <%= image_tag product.cover_photo, class: "h-full w-full object-cover" %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-pink-200 to-orange-200 text-6xl">
              ✨
            </div>
          <% end %>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="min-w-0 flex-1 line-clamp-2 text-lg font-black leading-snug text-slate-950"><%= product.title %></h3>
            <span class="shrink-0 rounded-full bg-slate-900/5 px-2.5 py-1 text-[11px] font-black uppercase tracking-wide text-slate-500">
              <%= product_status_label(product.status) %>
            </span>
          </div>

          <p class="mt-3 text-lg font-black text-pink-600">
            <%= number_to_currency(product.price_per_day, unit: "₫", precision: 0, format: "%n %u") %>
            <span class="text-sm font-bold text-slate-400"><%= t("owner.products.per_day") %></span>
          </p>

          <div class="mt-auto pt-5">
            <div class="grid grid-cols-2 gap-2">
              <%= link_to t("owner.availability.open"),
                owner_product_availability_path(product),
                class: "inline-flex items-center justify-center rounded-2xl border border-pink-200 bg-pink-50 px-3 py-2.5 text-sm font-black text-pink-600 transition hover:bg-pink-100" %>
              <%= link_to t("actions.edit"),
                edit_owner_product_path(product),
                class: "inline-flex items-center justify-center rounded-2xl bg-slate-950 px-3 py-2.5 text-sm font-black text-white transition hover:bg-slate-800" %>
            </div>

            <% unless product.inactive? %>
              <%= button_to t("actions.archive"),
                owner_product_path(product),
                method: :delete,
                form: { class: "mt-3" },
                class: "w-full text-center text-sm font-bold text-slate-400 transition hover:text-red-500",
                data: { turbo_confirm: t("owner.products.archive_confirm") } %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
