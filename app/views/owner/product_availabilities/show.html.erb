<section class="wearly-page max-w-5xl">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="wearly-eyebrow"><%= t("owner.availability.eyebrow") %></p>
      <h1 class="wearly-title"><%= @product.title %></h1>
      <p class="wearly-subtitle"><%= t("owner.availability.subtitle") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t("actions.edit"), edit_owner_product_path(@product), class: "wearly-btn wearly-btn-ghost" %>
      <%= link_to t("owner.availability.back"), owner_products_path, class: "wearly-btn wearly-btn-primary" %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]"
       data-controller="availability-calendar"
       data-availability-calendar-mode-value="owner"
       data-availability-calendar-month-value="<%= @from.strftime("%Y-%m") %>"
       data-availability-calendar-busy-value="<%= @busy.to_json %>">
    <div class="wearly-panel p-6">
      <div class="mb-5 flex items-center justify-between gap-3">
        <button type="button" class="h-10 w-10 rounded-full border border-white/15 bg-white/10 font-black text-white" data-action="availability-calendar#previousMonth">‹</button>
        <p class="text-lg font-black text-white" data-availability-calendar-target="label"></p>
        <button type="button" class="h-10 w-10 rounded-full border border-white/15 bg-white/10 font-black text-white" data-action="availability-calendar#nextMonth">›</button>
      </div>

      <div class="mb-2 grid grid-cols-7 gap-2 text-center text-[11px] font-black uppercase tracking-wide text-white/40">
          <% weekday_labels_short.each do |day| %>
            <span><%= day %></span>
          <% end %>
      </div>
      <div class="grid grid-cols-7 gap-2" data-availability-calendar-target="grid"></div>

      <div class="mt-6 flex flex-wrap gap-4 text-sm font-bold text-white/70">
        <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-orange-300"></span><%= t("owner.availability.legend_booking") %></span>
        <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-slate-300"></span><%= t("owner.availability.legend_block") %></span>
        <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-pink-400"></span><%= t("owner.availability.legend_selected") %></span>
      </div>
    </div>

    <div class="space-y-6">
      <div class="wearly-panel p-6">
        <h2 class="text-xl font-black text-white"><%= t("owner.availability.block_title") %></h2>
        <p class="mt-2 text-sm font-semibold text-white/55"><%= t("owner.availability.block_hint") %></p>

        <%= form_with model: @blocked_date, url: owner_product_blocked_dates_path(@product), class: "mt-5 space-y-4" do |f| %>
          <div>
            <%= f.label :start_on, t("owner.availability.start_on"), class: "font-black" %>
            <%= f.date_field :start_on, required: true, class: "mt-2 w-full", data: { availability_calendar_target: "startOn" } %>
          </div>
          <div>
            <%= f.label :end_on, t("owner.availability.end_on"), class: "font-black" %>
            <%= f.date_field :end_on, required: true, class: "mt-2 w-full", data: { availability_calendar_target: "endOn" } %>
          </div>
          <div>
            <%= f.label :note, t("owner.availability.note"), class: "font-black" %>
            <%= f.text_field :note, class: "mt-2 w-full", placeholder: t("owner.availability.note_placeholder") %>
          </div>
          <%= f.submit t("owner.availability.block_submit"), class: "wearly-btn wearly-btn-primary w-full cursor-pointer" %>
        <% end %>
      </div>

      <div class="wearly-panel p-6">
        <h2 class="text-xl font-black text-white"><%= t("owner.availability.blocks_title") %></h2>
        <% if @blocked_dates.any? %>
          <ul class="mt-4 space-y-3">
            <% @blocked_dates.each do |block| %>
              <li class="flex items-start justify-between gap-3 rounded-2xl border border-white/10 bg-white/5 p-4">
                <div>
                  <p class="font-black text-white"><%= l(block.start_on) %> → <%= l(block.end_on) %></p>
                  <% if block.note.present? %>
                    <p class="mt-1 text-sm font-semibold text-white/55"><%= block.note %></p>
                  <% end %>
                </div>
                <%= button_to t("actions.delete"), owner_product_blocked_date_path(@product, block), method: :delete, class: "text-sm font-black text-rose-300 hover:text-rose-200" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm font-semibold text-white/55"><%= t("owner.availability.blocks_empty") %></p>
        <% end %>
      </div>
    </div>
  </div>
</section>
