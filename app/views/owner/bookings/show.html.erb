<section class="max-w-7xl mx-auto px-5 py-10">
  <%= link_to "← #{t("owner.bookings.back")}", owner_bookings_path, class: "font-black text-pink-600" %>

  <div class="mt-6 grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
      <div class="flex items-start justify-between gap-4">
        <div>
          <span class="px-3 py-1 rounded-full bg-pink-50 text-pink-600 text-xs font-black uppercase">
            <%= @booking.status %>
          </span>

          <h1 class="mt-4 text-4xl font-black"><%= @booking.product.title %></h1>

          <p class="mt-2 text-slate-500">
            <%= t("admin.bookings.renter") %>:
            <%= @booking.renter.full_name.presence || @booking.renter.email %>
          </p>
        </div>
      </div>

      <div class="mt-6 grid md:grid-cols-2 gap-4">
        <div class="rounded-2xl bg-slate-50 p-5">
          <p class="text-slate-500 font-bold"><%= t("bookings.start_time") %></p>
          <p class="mt-2 font-black"><%= @booking.start_time&.strftime("%d %b %Y, %H:%M") || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-5">
          <p class="text-slate-500 font-bold"><%= t("bookings.end_time") %></p>
          <p class="mt-2 font-black"><%= @booking.end_time&.strftime("%d %b %Y, %H:%M") || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-5">
          <p class="text-slate-500 font-bold"><%= t("bookings.pickup_address") %></p>
          <p class="mt-2 font-black"><%= @booking.pickup_address.presence || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-5">
          <p class="text-slate-500 font-bold"><%= t("bookings.return_address") %></p>
          <p class="mt-2 font-black"><%= @booking.return_address.presence || "-" %></p>
        </div>
      </div>
    </div>

    <div class="bg-slate-950 text-white rounded-[2rem] p-6 shadow-sm h-fit">
      <h2 class="text-xl font-black mb-5"><%= t("admin.bookings.payment_summary") %></h2>

      <div class="space-y-4">
        <div class="flex justify-between">
          <span class="text-slate-300"><%= t("admin.bookings.rental_amount") %></span>
          <span class="font-black"><%= number_to_currency(@booking.rental_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="flex justify-between">
          <span class="text-slate-300"><%= t("products.cleaning_fee") %></span>
          <span class="font-black"><%= number_to_currency(@booking.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="flex justify-between">
          <span class="text-slate-300"><%= t("products.deposit") %></span>
          <span class="font-black"><%= number_to_currency(@booking.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>

        <div class="pt-4 border-t border-white/10 flex justify-between">
          <span class="text-slate-300"><%= t("admin.bookings.total") %></span>
          <span class="font-black text-pink-300"><%= number_to_currency(@booking.total_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></span>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <% if @booking.status == "pending" %>
          <%= button_to t("owner.bookings.accept"), accept_owner_booking_path(@booking), method: :patch, class: "w-full py-3 rounded-2xl bg-green-500 text-white font-black" %>

          <%= button_to t("owner.bookings.reject"), reject_owner_booking_path(@booking), method: :patch, class: "w-full py-3 rounded-2xl bg-red-500 text-white font-black" %>
        <% elsif @booking.status == "accepted" %>
          <%= button_to t("owner.bookings.complete"), complete_owner_booking_path(@booking), method: :patch, class: "w-full py-3 rounded-2xl bg-pink-500 text-white font-black" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
