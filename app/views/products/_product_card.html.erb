<%= link_to product_path(product), class: "group bg-white rounded-[2rem] p-4 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition duration-300" do %>
  <div class="aspect-[4/5] rounded-[1.5rem] bg-slate-100 overflow-hidden">
    <% if product.cover_photo.present? %>
      <%= image_tag product.cover_photo, class: "w-full h-full object-cover group-hover:scale-105 transition duration-500" %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center text-6xl bg-gradient-to-br from-pink-100 to-orange-100">
        ✨
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <p class="text-xs font-black uppercase tracking-wide text-pink-500"><%= product.product_type %></p>
    <h3 class="mt-1 font-black text-lg line-clamp-2"><%= product.title %></h3>
    <p class="mt-1 text-sm text-slate-500"><%= [product.size, product.color, product.city].compact_blank.join(" • ") %></p>

    <p class="mt-3 font-black text-pink-600">
      <%= t("products.price_per_day", price: number_to_currency(product.price_per_day, unit: "₫", precision: 0, format: "%n %u")) %>
    </p>
  </div>
<% end %>
