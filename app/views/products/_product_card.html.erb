<%= link_to product_path(product), class: "group overflow-hidden rounded-[1.75rem] bg-[#f7f2ec] p-3 shadow-[0_18px_50px_rgba(0,0,0,0.35)] transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_28px_70px_rgba(236,72,153,0.28)]" do %>
  <div class="aspect-[4/5] overflow-hidden rounded-[1.35rem] bg-slate-200">
    <% if product.cover_photo.present? %>
      <%= image_tag product.cover_photo, class: "h-full w-full object-cover transition duration-700 group-hover:scale-110" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-pink-200 to-orange-200 text-6xl">
        ✨
      </div>
    <% end %>
  </div>

  <div class="px-1 pb-1 pt-4">
    <p class="text-[11px] font-black uppercase tracking-[0.16em] text-pink-600"><%= product_type_label(product.product_type) %></p>
    <h3 class="mt-1 line-clamp-2 text-lg font-black text-slate-950"><%= product.title %></h3>
    <p class="mt-1 text-sm font-semibold text-slate-500"><%= [product.size, product.color, product.city].compact_blank.join(" • ") %></p>

    <p class="mt-3 font-black text-pink-600">
      <%= t("products.price_per_day", price: number_to_currency(product.price_per_day, unit: "₫", precision: 0, format: "%n %u")) %>
    </p>
  </div>
<% end %>
