<section class="wearly-page">
  <p class="wearly-eyebrow"><%= t("app.name") %></p>
  <h1 class="wearly-title"><%= t("products.index_title") %></h1>
  <p class="wearly-subtitle"><%= t("products.index_subtitle") %></p>

  <%= form_with url: products_path, method: :get, local: true, class: "wearly-panel mt-8 grid gap-3 p-4 md:grid-cols-4" do %>
    <%= text_field_tag :q, params[:q], placeholder: t("products.search_placeholder"), class: "md:col-span-2" %>

    <%= select_tag :product_type,
      options_for_select(product_type_options(include_blank: true), params[:product_type]) %>

    <%= submit_tag t("products.search"), class: "wearly-btn wearly-btn-primary w-full cursor-pointer" %>
  <% end %>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% @products.each do |product| %>
      <%= render "product_card", product: product %>
    <% end %>
  </div>
</section>
