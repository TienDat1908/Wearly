<section class="box-border max-w-7xl mx-auto px-5 py-3 lg:h-[calc(100vh-132px)] lg:overflow-hidden">
  <div class="grid h-full lg:grid-cols-2 gap-7 items-stretch">
    <div class="min-h-0">
      <% if @product.cover_photo.present? %>
        <div data-controller="product-gallery" class="flex h-full min-h-0 flex-col gap-3">
          <div class="relative min-h-0 flex-1 rounded-[2.5rem] bg-gradient-to-br from-white via-white to-pink-50 shadow-2xl shadow-pink-100 border border-orange-100 overflow-hidden">
            <%= image_tag @product.cover_photo,
              data: { product_gallery_target: "image" },
              class: "h-full w-full object-contain p-4 transition duration-300" %>

            <div data-product-gallery-target="coverBadge" class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-sm font-black text-pink-600 shadow-lg backdrop-blur">
              <%= t("products.cover_photo") %>
            </div>

            <div data-product-gallery-target="counter" class="absolute right-5 bottom-5 rounded-full bg-slate-950/85 px-4 py-2 text-sm font-black text-white backdrop-blur">
              1 / <%= @product.photo_gallery.size %>
            </div>

            <% if @product.photo_gallery.size > 1 %>
              <button type="button"
                data-action="product-gallery#previous"
                class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-white/90 px-3 py-2 text-xl font-black text-slate-950 shadow-xl backdrop-blur transition hover:bg-pink-500 hover:text-white"
                aria-label="Previous photo">
                ‹
              </button>

              <button type="button"
                data-action="product-gallery#next"
                class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full bg-white/90 px-3 py-2 text-xl font-black text-slate-950 shadow-xl backdrop-blur transition hover:bg-pink-500 hover:text-white"
                aria-label="Next photo">
                ›
              </button>
            <% end %>
          </div>

          <div class="no-scrollbar flex h-16 flex-none gap-2.5 overflow-x-auto">
            <% @product.photo_gallery.each_with_index do |photo, index| %>
              <button type="button"
                data-product-gallery-target="thumb"
                data-action="product-gallery#select"
                data-index="<%= index %>"
                data-full-url="<%= url_for(photo) %>"
                data-alt="<%= @product.title %> photo <%= index + 1 %>"
                class="group relative block h-16 min-w-16 overflow-hidden rounded-[1rem] bg-white border transition <%= index.zero? ? "border-pink-400 ring-4 ring-pink-100" : "border-orange-100" %>">
                <%= image_tag photo, class: "h-full w-16 object-cover group-hover:scale-110 transition duration-500" %>
                <% if index.zero? %>
                  <span class="absolute inset-x-2 bottom-2 rounded-full bg-white/90 py-1 text-center text-[10px] font-black text-pink-600 backdrop-blur">
                    <%= t("products.cover_photo_short") %>
                  </span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="rounded-[2.75rem] aspect-[4/5] bg-gradient-to-br from-pink-100 to-orange-100 flex items-center justify-center text-8xl">
          ✨
        </div>
      <% end %>
    </div>

    <div class="flex h-full min-h-0 flex-col overflow-hidden bg-white rounded-[2rem] p-5 shadow-sm">
      <p class="text-pink-600 font-black uppercase tracking-wide"><%= @product.product_type %></p>
      <h1 class="mt-1 line-clamp-2 text-3xl lg:text-[2.15rem] font-black leading-tight"><%= @product.title %></h1>
      <%= link_to user_path(@product.owner), class: "mt-3 flex items-center gap-3 rounded-2xl bg-slate-50 p-2.5 hover:bg-pink-50 transition" do %>
        <div class="w-10 h-10 rounded-2xl overflow-hidden bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black">
          <% if @product.owner.avatar.attached? %>
            <%= image_tag @product.owner.avatar, class: "w-full h-full object-cover" %>
          <% else %>
            <%= @product.owner.full_name.to_s.first.presence || "O" %>
          <% end %>
        </div>

        <div>
          <p class="text-sm text-slate-500 font-bold"><%= t("profiles.owner_profile") %></p>
          <p class="font-black text-slate-950"><%= @product.owner.full_name.presence || @product.owner.email %></p>
        </div>
      <% end %>

      <% if @chat_booking.present? %>
        <div class="mt-3">
          <%= booking_chat_button(@chat_booking, viewer: current_user, class: "w-full px-4 py-3 rounded-full bg-pink-500 text-white font-black") %>
        </div>
      <% end %>

      <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-2"><%= @product.description %></p>

      <div class="mt-3 rounded-2xl bg-pink-50 p-3.5">
        <p class="text-sm text-pink-600 font-bold"><%= t("products.fulfillment_options") %></p>
        <p class="mt-1 font-black">
          <%= @product.available_pickup_methods.map { |method| t("bookings.#{method}") }.join(" · ") %>
        </p>

        <% if @product.available_pickup_methods.include?("self_pickup") %>
          <p class="mt-1.5 line-clamp-1 text-sm text-slate-600"><%= @product.pickup_location %></p>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-2.5 mt-3">
        <div class="rounded-2xl bg-slate-50 p-3">
          <p class="text-sm text-slate-500"><%= t("products.size") %></p>
          <p class="font-black"><%= @product.size.presence || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-3">
          <p class="text-sm text-slate-500"><%= t("products.color") %></p>
          <p class="font-black"><%= @product.color.presence || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-3">
          <p class="text-sm text-slate-500"><%= t("products.deposit") %></p>
          <p class="font-black"><%= number_to_currency(@product.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-3">
          <p class="text-sm text-slate-500"><%= t("products.cleaning_fee") %></p>
          <p class="font-black"><%= number_to_currency(@product.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>
      </div>

      <div class="mt-auto flex items-end justify-between gap-4 pt-3">
        <div>
          <p class="text-sm text-slate-500"><%= t("products.rental_price") %></p>
          <p class="text-3xl font-black text-pink-600 leading-none">
            <%= number_to_currency(@product.price_per_day, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>

        <% if user_signed_in? && @product.owner_id == current_user.id %>
          <%= link_to t("products.manage_item"),
            edit_owner_product_path(@product),
            class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black whitespace-nowrap" %>
        <% elsif user_signed_in? %>
          <%= link_to t("products.rent_now"),
            new_booking_path(product_id: @product.id),
            class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black whitespace-nowrap" %>
        <% else %>
          <%= link_to t("products.sign_in_to_rent"),
            new_user_session_path,
            class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black whitespace-nowrap" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
