<section class="max-w-7xl mx-auto px-5 py-10">
  <div class="grid lg:grid-cols-2 gap-10">
    <div class="grid grid-cols-2 gap-4">
      <% if @product.photos.attached? %>
        <% @product.photos.each do |photo| %>
          <%= image_tag photo, class: "rounded-[2rem] w-full aspect-[4/5] object-cover bg-white" %>
        <% end %>
      <% else %>
        <div class="col-span-2 rounded-[2rem] aspect-[4/5] bg-gradient-to-br from-pink-100 to-orange-100 flex items-center justify-center text-8xl">
          ✨
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-[2rem] p-8 shadow-sm h-fit">
      <p class="text-pink-600 font-black uppercase tracking-wide"><%= @product.product_type %></p>
      <h1 class="text-4xl font-black mt-2"><%= @product.title %></h1>

      <p class="mt-4 text-slate-600"><%= @product.description %></p>

      <div class="grid grid-cols-2 gap-4 mt-6">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= t("products.size") %></p>
          <p class="font-black"><%= @product.size.presence || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= t("products.color") %></p>
          <p class="font-black"><%= @product.color.presence || "-" %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= t("products.deposit") %></p>
          <p class="font-black"><%= number_to_currency(@product.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= t("products.cleaning_fee") %></p>
          <p class="font-black"><%= number_to_currency(@product.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>
      </div>

      <div class="mt-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm text-slate-500"><%= t("products.rental_price") %></p>
          <p class="text-3xl font-black text-pink-600">
            <%= number_to_currency(@product.price_per_day, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>

        <% if user_signed_in? %>
          <%= link_to t("products.rent_now"), new_booking_path(product_id: @product.id), class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black" %>
        <% else %>
          <%= link_to t("products.sign_in_to_rent"), new_user_session_path, class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
