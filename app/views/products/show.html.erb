<section class="wearly-page box-border !py-3 lg:h-[calc(100vh-132px)] lg:overflow-hidden lg:!pb-3">
  <div class="grid h-full items-stretch gap-7 lg:grid-cols-2">
    <div class="min-h-0">
      <% if @product.cover_photo.present? %>
        <div data-controller="product-gallery" class="flex h-full min-h-0 flex-col gap-3">
          <div class="relative min-h-0 flex-1 overflow-hidden rounded-[2.5rem] border border-white/15 bg-[#f7f2ec] shadow-2xl shadow-pink-950/40">
            <%= image_tag @product.cover_photo,
              data: { product_gallery_target: "image" },
              class: "h-full w-full object-contain p-4 transition duration-300" %>

            <div data-product-gallery-target="coverBadge" class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-sm font-black text-pink-600 shadow-lg backdrop-blur">
              <%= t("products.cover_photo") %>
            </div>

            <div data-product-gallery-target="counter" class="absolute bottom-5 right-5 rounded-full bg-slate-950/85 px-4 py-2 text-sm font-black text-white backdrop-blur">
              1 / <%= @product.photo_gallery.size %>
            </div>

            <% if @product.photo_gallery.size > 1 %>
              <button type="button"
                data-action="product-gallery#previous"
                class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-white/90 px-3 py-2 text-xl font-black text-slate-950 shadow-xl backdrop-blur transition hover:bg-pink-500 hover:text-white"
                aria-label="<%= t("products.gallery_previous") %>">
                ‹
              </button>

              <button type="button"
                data-action="product-gallery#next"
                class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full bg-white/90 px-3 py-2 text-xl font-black text-slate-950 shadow-xl backdrop-blur transition hover:bg-pink-500 hover:text-white"
                aria-label="<%= t("products.gallery_next") %>">
                ›
              </button>
            <% end %>
          </div>

          <div class="no-scrollbar flex h-16 flex-none gap-2.5 overflow-x-auto">
            <% @product.photo_gallery.each_with_index do |photo, index| %>
              <button type="button"
                data-product-gallery-target="thumb"
                data-action="product-gallery#select"
                data-index="<%= index %>"
                data-full-url="<%= url_for(photo) %>"
                data-alt="<%= @product.title %> photo <%= index + 1 %>"
                class="group relative block h-16 min-w-16 overflow-hidden rounded-[1rem] border bg-white transition <%= index.zero? ? "border-pink-400 ring-4 ring-pink-500/30" : "border-white/20" %>">
                <%= image_tag photo, class: "h-full w-16 object-cover transition duration-500 group-hover:scale-110" %>
                <% if index.zero? %>
                  <span class="absolute inset-x-2 bottom-2 rounded-full bg-white/90 py-1 text-center text-[10px] font-black text-pink-600 backdrop-blur">
                    <%= t("products.cover_photo_short") %>
                  </span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="flex aspect-[4/5] items-center justify-center rounded-[2.75rem] bg-gradient-to-br from-pink-500/30 to-orange-400/20 text-8xl">
          ✨
        </div>
      <% end %>
    </div>

    <div class="wearly-panel flex h-full min-h-0 flex-col overflow-hidden p-5">
      <p class="wearly-eyebrow !tracking-[0.2em]"><%= product_type_label(@product.product_type) %></p>
      <h1 class="mt-1 line-clamp-2 text-3xl font-black leading-tight tracking-tight text-white lg:text-[2.15rem]"><%= @product.title %></h1>
      <%= link_to user_path(@product.owner), class: "mt-3 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-2.5 transition hover:bg-white/10" do %>
        <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-pink-500 to-orange-400 font-black text-white">
          <% if @product.owner.avatar.attached? %>
            <%= image_tag @product.owner.avatar, class: "h-full w-full object-cover" %>
          <% else %>
            <%= @product.owner.full_name.to_s.first.presence || "O" %>
          <% end %>
        </div>

        <div>
          <p class="text-sm font-bold text-white/50"><%= t("profiles.owner_profile") %></p>
          <p class="font-black text-white"><%= @product.owner.full_name.presence || @product.owner.email %></p>
        </div>
      <% end %>

      <% if @chat_booking.present? %>
        <div class="mt-3">
          <%= booking_chat_button(@chat_booking, viewer: current_user, class: "wearly-btn wearly-btn-primary w-full") %>
        </div>
      <% end %>

      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-white/65"><%= @product.description %></p>

      <div class="mt-3 rounded-2xl border border-pink-400/20 bg-pink-500/10 p-3.5">
        <p class="text-sm font-bold text-pink-200"><%= t("products.fulfillment_options") %></p>
        <p class="mt-1 font-black text-white">
          <%= @product.available_pickup_methods.map { |method| t("bookings.#{method}") }.join(" · ") %>
        </p>

        <% if @product.available_pickup_methods.include?("self_pickup") %>
          <p class="mt-1.5 line-clamp-1 text-sm text-white/60"><%= @product.pickup_location %></p>
        <% end %>
      </div>

      <div class="mt-3 grid grid-cols-2 gap-2.5">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
          <p class="text-sm text-white/50"><%= t("products.size") %></p>
          <p class="font-black text-white"><%= @product.size.presence || "-" %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
          <p class="text-sm text-white/50"><%= t("products.color") %></p>
          <p class="font-black text-white"><%= @product.color.presence || "-" %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
          <p class="text-sm text-white/50"><%= t("products.deposit") %></p>
          <p class="font-black text-white"><%= number_to_currency(@product.deposit_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
          <p class="text-sm text-white/50"><%= t("products.cleaning_fee") %></p>
          <p class="font-black text-white"><%= number_to_currency(@product.cleaning_fee.to_i, unit: "₫", precision: 0, format: "%n %u") %></p>
        </div>
      </div>

      <div class="mt-auto flex items-end justify-between gap-4 pt-3">
        <div>
          <p class="text-sm text-white/50"><%= t("products.rental_price") %></p>
          <p class="text-3xl font-black leading-none text-pink-300">
            <%= number_to_currency(@product.price_per_day, unit: "₫", precision: 0, format: "%n %u") %>
          </p>
        </div>

        <% if user_signed_in? && @product.owner_id == current_user.id %>
          <%= link_to t("products.manage_item"),
            edit_owner_product_path(@product),
            class: "wearly-btn wearly-btn-primary whitespace-nowrap" %>
        <% elsif user_signed_in? %>
          <%= link_to t("products.rent_now"),
            new_booking_path(product_id: @product.id),
            class: "wearly-btn wearly-btn-primary whitespace-nowrap" %>
        <% else %>
          <%= link_to t("products.sign_in_to_rent"),
            new_user_session_path,
            class: "wearly-btn wearly-btn-primary whitespace-nowrap" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
