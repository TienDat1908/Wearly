<section class="wearly-page">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="wearly-eyebrow"><%= t("bookings.my_bookings") %></p>
      <h1 class="wearly-title"><%= t("bookings.index_title") %></h1>
      <p class="wearly-subtitle"><%= t("bookings.index_subtitle") %></p>
    </div>

    <%= link_to t("nav.explore"), products_path, class: "wearly-btn wearly-btn-primary" %>
  </div>

  <% if @bookings.any? %>
    <div class="grid gap-5">
      <% @bookings.each do |booking| %>
        <% product = booking.product %>

        <div class="wearly-panel p-4 md:p-5">
          <div class="grid items-center gap-5 md:grid-cols-[140px_1fr_auto]">
            <%= link_to booking_path(booking), class: "block" do %>
              <div class="aspect-[4/5] overflow-hidden rounded-[1.5rem] bg-[#f7f2ec]">
                <% if product.cover_photo.present? %>
                  <%= image_tag product.cover_photo, class: "h-full w-full object-cover" %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-pink-200 to-orange-200 text-5xl">
                    ✨
                  </div>
                <% end %>
              </div>
            <% end %>

            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-pink-500/15 px-3 py-1 text-xs font-black uppercase text-pink-200">
                  <%= booking_status_label(booking) %>
                </span>

                <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-black text-white/70">
                  <%= t("bookings.rental_days_count", count: booking.rental_days.to_i) %>
                </span>

                <%= acceptance_countdown_badge(booking, role: :renter) %>
              </div>

              <%= link_to booking_path(booking), class: "mt-3 block" do %>
                <h2 class="text-2xl font-black text-white transition hover:text-pink-200">
                  <%= product.title %>
                </h2>
              <% end %>

              <p class="mt-1 text-white/55">
                <%= product.city.presence || "Wearly" %>
                <% if product.district.present? %>
                  • <%= product.district %>
                <% end %>
              </p>

              <%= link_to user_path(booking.owner), class: "mt-3 inline-flex items-center gap-2 text-sm font-black text-pink-200 hover:text-white" do %>
                <span>👤</span>
                <span><%= t("profiles.view_owner") %>: <%= booking.owner.full_name.presence || booking.owner.email %></span>
              <% end %>

              <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <p class="font-bold text-white/50"><%= t("bookings.start_time") %></p>
                  <p class="mt-1 font-black text-white"><%= booking.start_time ? l(booking.start_time, format: :long) : "-" %></p>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <p class="font-bold text-white/50"><%= t("bookings.end_time") %></p>
                  <p class="mt-1 font-black text-white"><%= booking.end_time ? l(booking.end_time, format: :long) : "-" %></p>
                </div>
              </div>
            </div>

            <div class="md:text-right">
              <p class="text-sm font-bold text-white/50"><%= t("admin.bookings.total") %></p>
              <p class="mt-1 text-2xl font-black text-pink-300">
                <%= number_to_currency(booking.total_amount.to_i, unit: "₫", precision: 0, format: "%n %u") %>
              </p>

              <div class="mt-5 flex gap-2 md:flex-col">
                <%= link_to t("admin.actions.view"), booking_path(booking), class: "wearly-btn wearly-btn-ghost text-center" %>
                <%= booking_chat_button(booking, viewer: current_user, class: "wearly-btn wearly-btn-primary w-full") %>

                <% if %w[pending accepted].include?(booking.status) %>
                  <%= button_to t("bookings.cancel"), cancel_booking_path(booking), method: :patch, class: "w-full cursor-pointer rounded-full border border-rose-400/30 bg-rose-500/15 px-5 py-3 font-black text-rose-200" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="wearly-panel p-10 text-center">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-[2rem] bg-gradient-to-br from-pink-500/30 to-orange-400/20 text-4xl">
        🛍️
      </div>

      <h2 class="mt-5 text-3xl font-black text-white"><%= t("bookings.empty_title") %></h2>
      <p class="mt-2 text-white/55"><%= t("bookings.empty_subtitle") %></p>

      <%= link_to t("home.explore_now"), products_path, class: "wearly-btn wearly-btn-primary mt-6 inline-flex" %>
    </div>
  <% end %>
</section>
