<section class="min-h-[calc(100vh-92px)] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-5xl">
    <div class="text-center mb-8">
      <div class="mx-auto w-16 h-16 rounded-3xl bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black text-2xl shadow-lg shadow-pink-200">
        W
      </div>

      <h1 class="mt-5 text-4xl md:text-5xl font-black tracking-tight">
        <%= t("auth.sign_up_title") %>
      </h1>

      <p class="mt-3 text-slate-500">
        <%= t("auth.sign_up_subtitle") %>
      </p>
    </div>

    <div class="bg-white rounded-[2.5rem] p-6 md:p-8 shadow-2xl shadow-pink-100 border border-orange-100">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <%= f.label :full_name, t("auth.full_name"), class: "block font-black mb-2" %>
            <%= f.text_field :full_name, autofocus: true, autocomplete: "name", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.full_name_placeholder") %>
          </div>

          <div>
            <%= f.label :phone, t("auth.phone"), class: "block font-black mb-2" %>
            <%= f.telephone_field :phone, autocomplete: "tel", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.phone_placeholder") %>
          </div>
        </div>

        <div>
          <%= f.label :email, "Email", class: "block font-black mb-2" %>
          <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: "you@example.com" %>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <%= f.label :password, t("auth.password"), class: "block font-black mb-2" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.password_placeholder") %>
            <p class="mt-2 text-xs text-slate-500"><%= t("auth.password_hint") %></p>
          </div>

          <div>
            <%= f.label :password_confirmation, t("auth.password_confirmation"), class: "block font-black mb-2" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.password_confirmation_placeholder") %>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <%= f.label :role, t("auth.account_type"), class: "block font-black mb-2" %>
            <%= f.select :role, [[t("auth.renter"), "renter"], [t("auth.owner"), "owner"]], {}, class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400" %>
          </div>

          <div>
            <%= f.label :preferred_locale, t("auth.language"), class: "block font-black mb-2" %>
            <%= f.select :preferred_locale, [["English", "en"], ["Tiếng Việt", "vi"]], {}, class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400" %>
          </div>
        </div>

        <%= f.submit t("auth.sign_up"), class: "w-full py-4 rounded-2xl bg-gradient-to-r from-pink-500 to-orange-400 text-white font-black shadow-xl shadow-pink-200 hover:-translate-y-0.5 transition" %>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-slate-500">
          <%= t("auth.already_have_account") %>
          <%= link_to t("auth.sign_in"), new_session_path(resource_name), class: "font-black text-pink-600 hover:text-pink-700" %>
        </p>
      </div>
    </div>
  </div>
</section>
