<% content_for :auth_immersive, flush: true do %>1<% end %>

<section class="auth-immersive">
  <%= render "devise/shared/auth_stage" %>

  <%= link_to root_path, class: "absolute left-5 top-5 z-20 inline-flex items-center gap-2 text-sm font-black text-white/90 transition hover:text-white" do %>
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-pink-500 to-orange-400 font-black shadow-lg shadow-pink-500/30">W</span>
    <span class="hidden sm:inline"><%= t("app.name") %></span>
  <% end %>

  <% if notice.present? || alert.present? %>
    <div class="absolute inset-x-0 top-5 z-20 mx-auto w-full max-w-lg px-5">
      <% if notice.present? %>
        <div class="rounded-2xl border border-emerald-300/30 bg-emerald-500/20 px-4 py-3 text-sm font-semibold text-emerald-50 backdrop-blur"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mt-2 rounded-2xl border border-rose-300/30 bg-rose-500/20 px-4 py-3 text-sm font-semibold text-rose-50 backdrop-blur"><%= alert %></div>
      <% end %>
    </div>
  <% end %>

  <div class="relative z-10 flex h-full items-center justify-center overflow-y-auto px-5 py-14">
    <div class="auth-panel my-auto">
      <p class="text-[11px] font-black uppercase tracking-[0.28em] text-pink-200"><%= t("auth.sign_up") %></p>
      <h1 class="mt-2 text-[2rem] font-black leading-[1.08] tracking-tight text-white sm:text-[2.2rem]">
        <%= t("auth.sign_up_title") %>
      </h1>
      <p class="mx-auto mt-2 max-w-sm text-sm font-medium leading-6 text-white/80">
        <%= t("auth.sign_up_subtitle") %>
      </p>

      <% if @oauth_signup %>
        <div class="mt-4 rounded-2xl border border-pink-200/30 bg-pink-500/15 px-4 py-3 text-left text-sm text-pink-50 backdrop-blur">
          <p class="font-black text-white"><%= t("auth.oauth.complete_signup_title") %></p>
          <p class="mt-1 text-white/80"><%= t("auth.oauth.complete_signup_hint") %></p>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-5 space-y-3.5 text-left" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource, dark: true %>

        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2 sm:col-span-1">
            <%= f.label :full_name, t("auth.full_name"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
            <%= f.text_field :full_name, autofocus: true, autocomplete: "name", placeholder: t("auth.full_name_placeholder") %>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <%= f.label :phone, t("auth.phone"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
            <%= f.telephone_field :phone, autocomplete: "tel", placeholder: t("auth.phone_placeholder") %>
          </div>
        </div>

        <div>
          <%= f.label :email, t("auth_extra.email"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
          <%= f.email_field :email, autocomplete: "email", readonly: @oauth_signup, class: (@oauth_signup ? "opacity-70" : nil), placeholder: t("auth_extra.email_placeholder") %>
        </div>

        <% unless @oauth_signup %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= f.label :password, t("auth.password"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: t("auth.password_placeholder") %>
            </div>
            <div>
              <%= f.label :password_confirmation, t("auth.password_confirmation"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("auth.password_confirmation_placeholder") %>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-3 pt-1">
          <div>
            <%= f.label :role, t("auth.account_type"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
            <%= f.select :role, [[t("auth.renter"), "renter"], [t("auth.owner"), "owner"]] %>
          </div>
          <div>
            <%= f.label :preferred_locale, t("auth.language"), class: "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-white/70" %>
            <%= f.select :preferred_locale, [["English", "en"], ["Tiếng Việt", "vi"]] %>
          </div>
        </div>

        <%= f.submit t("auth.sign_up"),
          class: "mt-2 w-full cursor-pointer rounded-full bg-gradient-to-r from-sky-400 via-pink-500 to-orange-400 py-3.5 text-sm font-black lowercase tracking-[0.2em] text-white shadow-xl shadow-pink-950/40 transition hover:brightness-110" %>
      <% end %>

      <% unless @oauth_signup %>
        <div class="mt-5">
          <%= render "devise/shared/social_login", resource_name: resource_name, icons_only: true %>
        </div>
      <% end %>

      <p class="mt-5 text-sm text-white/70">
        <%= t("auth.already_have_account") %>
        <%= link_to t("auth.sign_in"), new_session_path(resource_name), class: "font-black text-white underline decoration-pink-300/70 underline-offset-4 hover:text-pink-200" %>
      </p>
    </div>
  </div>
</section>
