<section class="min-h-[calc(100vh-92px)] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-6xl grid lg:grid-cols-2 gap-8 items-center">
    <div class="hidden lg:block">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-pink-100 text-pink-700 text-sm font-black">
        ✨ <%= t("app.tagline") %>
      </div>

      <h1 class="mt-6 text-6xl font-black tracking-tight leading-[0.95]">
        <%= t("auth.sign_in_hero_title") %>
      </h1>

      <p class="mt-6 text-lg text-slate-600 max-w-lg">
        <%= t("auth.sign_in_hero_subtitle") %>
      </p>

      <div class="mt-8 grid grid-cols-3 gap-4 max-w-xl">
        <div class="rounded-[2rem] bg-white p-5 shadow-sm">
          <div class="text-3xl">👗</div>
          <p class="mt-3 font-black"><%= t("auth.feature_outfits") %></p>
        </div>

        <div class="rounded-[2rem] bg-white p-5 shadow-sm">
          <div class="text-3xl">📷</div>
          <p class="mt-3 font-black"><%= t("auth.feature_cameras") %></p>
        </div>

        <div class="rounded-[2rem] bg-white p-5 shadow-sm">
          <div class="text-3xl">✨</div>
          <p class="mt-3 font-black"><%= t("auth.feature_events") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-[2.5rem] p-6 md:p-8 shadow-2xl shadow-pink-100 border border-orange-100">
      <div class="text-center mb-8">
        <div class="mx-auto w-16 h-16 rounded-3xl bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black text-2xl shadow-lg shadow-pink-200">
          W
        </div>

        <h2 class="mt-5 text-3xl font-black"><%= t("auth.sign_in_title") %></h2>
        <p class="mt-2 text-slate-500"><%= t("auth.sign_in_subtitle") %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <div>
          <%= f.label :login, t("auth.login"), class: "block font-black mb-2" %>
          <%= f.text_field :login, autofocus: true, autocomplete: "email", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.login_placeholder") %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, t("auth.password"), class: "block font-black" %>
            <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "text-sm font-bold text-pink-600 hover:text-pink-700" %>
          </div>

          <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.password_placeholder") %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-3 text-sm font-bold text-slate-600">
            <%= f.check_box :remember_me, class: "rounded border-slate-300 text-pink-500 focus:ring-pink-400" %>
            <%= t("auth.remember_me") %>
          </label>
        <% end %>

        <%= f.submit t("auth.sign_in"), class: "w-full py-4 rounded-2xl bg-slate-950 text-white font-black shadow-xl shadow-slate-200 hover:-translate-y-0.5 transition" %>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-slate-500">
          <%= t("auth.no_account") %>
          <%= link_to t("auth.create_account"), new_registration_path(resource_name), class: "font-black text-pink-600 hover:text-pink-700" %>
        </p>
      </div>
    </div>
  </div>
</section>
