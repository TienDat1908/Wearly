<% content_for :auth_immersive, flush: true do %>1<% end %>

<section class="auth-immersive">
  <%= render "devise/shared/auth_stage" %>

  <%= link_to root_path, class: "absolute left-5 top-5 z-20 inline-flex items-center gap-2 text-sm font-black text-white/90 transition hover:text-white" do %>
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-pink-500 to-orange-400 font-black shadow-lg shadow-pink-500/30">W</span>
    <span class="hidden sm:inline"><%= t("app.name") %></span>
  <% end %>

  <% if notice.present? || alert.present? %>
    <div class="absolute inset-x-0 top-5 z-20 mx-auto w-full max-w-md px-5">
      <% if notice.present? %>
        <div class="rounded-2xl border border-emerald-300/30 bg-emerald-500/20 px-4 py-3 text-sm font-semibold text-emerald-50 backdrop-blur"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mt-2 rounded-2xl border border-rose-300/30 bg-rose-500/20 px-4 py-3 text-sm font-semibold text-rose-50 backdrop-blur"><%= alert %></div>
      <% end %>
    </div>
  <% end %>

  <div class="relative z-10 flex h-full items-center justify-center px-5">
    <div class="auth-panel">
      <p class="text-[11px] font-black uppercase tracking-[0.28em] text-pink-200"><%= t("app.name") %></p>
      <h1 class="mt-3 text-[2rem] font-black leading-[1.08] tracking-tight text-white sm:text-[2.2rem]">
        <%= t("auth.sign_in_hero_title") %>
      </h1>
      <p class="mx-auto mt-3 max-w-sm text-sm font-medium leading-6 text-white/80">
        <%= t("auth.sign_in_hero_subtitle") %>
      </p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-7 space-y-4 text-left" }) do |f| %>
        <div>
          <%= f.label :login, t("auth.login"), class: "mb-2 block text-xs font-bold uppercase tracking-[0.16em]" %>
          <%= f.text_field :login,
            autofocus: true,
            autocomplete: "email",
            placeholder: t("auth.login_placeholder") %>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between gap-3">
            <%= f.label :password, t("auth.password"), class: "block text-xs font-bold uppercase tracking-[0.16em]" %>
            <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "text-xs font-bold text-pink-200 hover:text-white" %>
          </div>
          <%= f.password_field :password,
            autocomplete: "current-password",
            placeholder: t("auth.password_placeholder") %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2.5 text-sm font-semibold text-white/85">
            <%= f.check_box :remember_me, class: "rounded border-white/40 bg-transparent text-pink-500 focus:ring-pink-400" %>
            <%= t("auth.remember_me") %>
          </label>
        <% end %>

        <%= f.submit t("auth.sign_in"),
          class: "mt-1 w-full cursor-pointer rounded-full bg-gradient-to-r from-sky-400 via-pink-500 to-orange-400 py-3.5 text-sm font-black lowercase tracking-[0.2em] text-white shadow-xl shadow-pink-950/40 transition hover:brightness-110" %>
      <% end %>

      <div class="mt-6">
        <%= render "devise/shared/social_login", resource_name: resource_name, icons_only: true %>
      </div>

      <p class="mt-6 text-sm text-white/75">
        <%= t("auth.no_account") %>
        <%= link_to t("auth.create_account"), new_registration_path(resource_name), class: "font-black text-white underline decoration-pink-300/70 underline-offset-4 hover:text-pink-200" %>
      </p>
    </div>
  </div>
</section>
