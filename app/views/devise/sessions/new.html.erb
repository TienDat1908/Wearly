<section class="relative min-h-[calc(100vh-92px)] lg:h-[calc(100vh-92px)] overflow-hidden px-5 py-4 lg:py-6">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(236,72,153,0.16),transparent_32rem),radial-gradient(circle_at_80%_10%,rgba(251,146,60,0.14),transparent_28rem),linear-gradient(135deg,#fffaf5_0%,#fff_48%,#f8fafc_100%)]"></div>

  <div class="mx-auto max-w-7xl h-full grid lg:grid-cols-[1fr_520px] gap-8 items-center">
    <div class="hidden lg:block">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 border border-pink-100 text-pink-700 text-sm font-black shadow-sm">
        ✨ <%= t("app.tagline") %>
      </div>

      <h1 class="mt-5 text-5xl xl:text-6xl font-black tracking-tight leading-[0.9] text-slate-950">
        <%= t("auth.sign_in_hero_title") %>
      </h1>

      <p class="mt-5 text-lg text-slate-600 max-w-xl leading-8">
        <%= t("auth.sign_in_hero_subtitle") %>
      </p>

      <div class="mt-7 relative max-w-lg">
        <div class="absolute -inset-4 rounded-[3rem] bg-gradient-to-br from-pink-200/60 to-orange-200/60 blur-2xl"></div>
        <div class="relative rounded-[2.5rem] bg-slate-950 text-white p-5 shadow-2xl shadow-pink-100">
          <div class="aspect-[16/10] rounded-[2.25rem] bg-gradient-to-br from-pink-500 via-rose-400 to-orange-300 flex items-center justify-center">
            <div class="text-center">
              <div class="text-6xl">👗</div>
              <p class="mt-4 text-2xl font-black">Outfits · Cameras · Moments</p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-3">
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-2xl">👗</p>
              <p class="mt-1 font-black"><%= t("auth.feature_outfits") %></p>
            </div>

            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-2xl">📷</p>
              <p class="mt-1 font-black"><%= t("auth.feature_cameras") %></p>
            </div>

            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-2xl">✨</p>
              <p class="mt-1 font-black"><%= t("auth.feature_events") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-[2.5rem] bg-white/90 backdrop-blur-xl p-5 md:p-6 shadow-2xl shadow-slate-200/70 border border-white">
      <div class="flex items-center justify-between gap-4 mb-5">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-pink-500"><%= t("auth.sign_in") %></p>
          <h2 class="mt-1 text-4xl font-black tracking-tight"><%= t("auth.sign_in_title") %></h2>
          <p class="mt-1 text-slate-500"><%= t("auth.sign_in_subtitle") %></p>
        </div>

        <div class="w-14 h-14 rounded-[1.35rem] bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black text-2xl shadow-xl shadow-pink-200">
          W
        </div>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-3" }) do |f| %>
        <div>
          <%= f.label :login, t("auth.login"), class: "block font-black mb-1.5" %>
          <%= f.text_field :login, autofocus: true, autocomplete: "email", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-3.5 text-slate-950 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.login_placeholder") %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, t("auth.password"), class: "block font-black" %>
            <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "text-sm font-black text-pink-600 hover:text-pink-700" %>
          </div>

          <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-2xl border-slate-200 bg-slate-50 px-5 py-3.5 text-slate-950 focus:border-pink-400 focus:ring-pink-400", placeholder: t("auth.password_placeholder") %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-3 text-sm font-bold text-slate-600">
            <%= f.check_box :remember_me, class: "rounded border-slate-300 text-pink-500 focus:ring-pink-400" %>
            <%= t("auth.remember_me") %>
          </label>
        <% end %>

        <%= f.submit t("auth.sign_in"), class: "w-full py-3.5 rounded-2xl bg-slate-950 text-white font-black shadow-xl shadow-slate-200 hover:-translate-y-0.5 transition cursor-pointer" %>
      <% end %>

      <div class="mt-4">
        <%= render "devise/shared/social_login", resource_name: resource_name, stacked: true, compact: true %>
      </div>

      <div class="mt-4 rounded-2xl bg-slate-50 p-3 text-center">
        <p class="text-slate-500">
          <%= t("auth.no_account") %>
          <%= link_to t("auth.create_account"), new_registration_path(resource_name), class: "font-black text-pink-600 hover:text-pink-700" %>
        </p>
      </div>
    </div>
  </div>
</section>
