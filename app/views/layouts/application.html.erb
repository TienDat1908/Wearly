<!DOCTYPE html>
<html>
  <head>
    <title><%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="<%= content_for?(:auth_immersive) ? 'bg-[#07040c] text-white overflow-hidden' : 'wearly-app bg-[#07040c] text-white' %>">
    <% unless content_for?(:auth_immersive) %>
    <nav class="sticky top-0 z-50 border-b border-white/10 bg-[#07040c]/80 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-5">
        <div class="h-[76px] flex items-center justify-between gap-5">
          <%= link_to root_path, class: "group flex items-center gap-3 min-w-0 shrink-0" do %>
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black text-xl shadow-lg shadow-pink-900/40 transition group-hover:-translate-y-0.5">
              W
            </div>

            <div class="min-w-0 hidden sm:block">
              <p class="font-black text-xl leading-none tracking-tight text-white"><%= t("app.name") %></p>
              <p class="mt-1 text-xs text-white/45 font-bold truncate"><%= t("app.tagline") %></p>
            </div>
          <% end %>

          <div class="hidden md:flex flex-1 items-center justify-center gap-1 text-sm font-black">
            <%= link_to t("nav.explore"), products_path, class: "px-4 py-2.5 rounded-full transition #{current_page?(products_path) ? 'bg-white text-slate-950' : 'text-white/70 hover:bg-white/10 hover:text-white'}" %>

            <% if user_signed_in? %>
              <%= link_to t("nav.my_rentals"), bookings_path, class: "px-4 py-2.5 rounded-full transition #{controller_name == 'bookings' && controller.class.module_parent_name.blank? ? 'bg-white text-slate-950' : 'text-white/70 hover:bg-white/10 hover:text-white'}" %>
              <%= link_to t("nav.messages"), conversations_path, class: "px-4 py-2.5 rounded-full transition #{controller_name == 'conversations' ? 'bg-white text-slate-950' : 'text-white/70 hover:bg-white/10 hover:text-white'}" %>

              <% if current_user.owner? %>
                <details class="relative group">
                  <summary class="list-none cursor-pointer px-4 py-2.5 rounded-full transition flex items-center gap-2 <%= controller_path.start_with?('owner/') ? 'bg-white text-slate-950' : 'text-white/70 hover:bg-white/10 hover:text-white' %>">
                    <span><%= t("nav.manage") %></span>
                    <% if @owner_pending_bookings_count.to_i.positive? %>
                      <span class="min-w-5 h-5 px-1 rounded-full bg-pink-500 text-white text-[10px] flex items-center justify-center">
                        <%= @owner_pending_bookings_count %>
                      </span>
                    <% end %>
                    <span class="text-xs opacity-70">⌄</span>
                  </summary>

                  <div class="absolute left-1/2 top-full mt-3 w-64 -translate-x-1/2 rounded-3xl border border-white/15 bg-[#121018] p-2 shadow-2xl shadow-black/50 z-50">
                    <%= link_to owner_bookings_path, class: "flex items-center justify-between gap-3 rounded-2xl px-4 py-3 text-white/80 hover:bg-pink-500/15 hover:text-pink-200 transition" do %>
                      <span><%= t("nav.booking_requests") %></span>
                      <% if @owner_pending_bookings_count.to_i.positive? %>
                        <span class="min-w-5 h-5 px-1 rounded-full bg-pink-500 text-white text-[10px] flex items-center justify-center">
                          <%= @owner_pending_bookings_count %>
                        </span>
                      <% end %>
                    <% end %>

                    <%= link_to t("nav.list_item"), owner_products_path, class: "block rounded-2xl px-4 py-3 text-white/80 hover:bg-pink-500/15 hover:text-pink-200 transition" %>
                  </div>
                </details>
              <% end %>
            <% end %>
          </div>

          <div class="hidden md:flex items-center justify-end gap-2 shrink-0">
            <% if user_signed_in? %>
              <details class="relative">
                <summary class="list-none cursor-pointer flex items-center gap-2 rounded-full border border-white/15 bg-white/10 p-1 pr-3 hover:bg-white/15 transition">
                  <span class="w-10 h-10 rounded-full overflow-hidden bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center font-black">
                    <% if current_user.avatar.attached? %>
                      <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                    <% else %>
                      <%= current_user.full_name.to_s.first.presence || current_user.email.to_s.first.upcase %>
                    <% end %>
                  </span>

                  <span class="max-w-32 truncate font-black text-sm text-white">
                    <%= current_user.full_name.presence || t("nav.profile") %>
                  </span>
                  <span class="text-xs text-white/40">⌄</span>
                </summary>

                <div class="absolute right-0 top-full mt-3 w-64 rounded-3xl border border-white/15 bg-[#121018] p-2 shadow-2xl shadow-black/50 z-50">
                  <%= link_to t("nav.profile"), edit_user_registration_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200 transition" %>

                  <% if current_user.admin? %>
                    <%= link_to t("admin.title"), admin_root_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200 transition" %>
                  <% end %>

                  <div class="my-2 h-px bg-white/10"></div>

                  <div class="px-2 py-1">
                    <div class="flex items-center gap-1 rounded-full bg-white/10 p-1 text-sm font-black">
                      <%= link_to "EN", locale_url(:en), class: "flex-1 text-center px-3 py-2 rounded-full transition #{I18n.locale == :en ? 'bg-white text-slate-950 shadow-sm' : 'text-white/50 hover:text-pink-200'}" %>
                      <%= link_to "VI", locale_url(:vi), class: "flex-1 text-center px-3 py-2 rounded-full transition #{I18n.locale == :vi ? 'bg-white text-slate-950 shadow-sm' : 'text-white/50 hover:text-pink-200'}" %>
                    </div>
                  </div>

                  <div class="my-2 h-px bg-white/10"></div>

                  <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "w-full rounded-2xl px-4 py-3 text-left font-black text-rose-300 hover:bg-rose-500/15 transition cursor-pointer" %>
                </div>
              </details>
            <% else %>
              <%= link_to t("nav.sign_in"), new_user_session_path, class: "px-4 py-2.5 rounded-full text-sm font-black text-white/80 hover:bg-white/10 hover:text-white transition" %>
              <%= link_to t("nav.sign_up"), new_user_registration_path, class: "px-5 py-3 rounded-full bg-gradient-to-r from-pink-500 to-orange-400 text-white text-sm font-black hover:-translate-y-0.5 transition shadow-lg shadow-pink-900/30" %>
            <% end %>
          </div>

          <details class="relative md:hidden">
            <summary class="list-none cursor-pointer w-11 h-11 rounded-full border border-white/15 bg-white/10 flex items-center justify-center font-black text-white">
              ☰
            </summary>

            <div class="absolute right-0 top-full mt-3 w-[calc(100vw-2rem)] max-w-sm rounded-3xl border border-white/15 bg-[#121018] p-2 shadow-2xl shadow-black/50 z-50">
              <%= link_to t("nav.explore"), products_path, class: "block rounded-2xl px-4 py-3 font-black #{current_page?(products_path) ? 'bg-white text-slate-950' : 'text-white/80 hover:bg-pink-500/15 hover:text-pink-200'}" %>

              <% if user_signed_in? %>
                <%= link_to t("nav.my_rentals"), bookings_path, class: "block rounded-2xl px-4 py-3 font-black #{current_page?(bookings_path) ? 'bg-white text-slate-950' : 'text-white/80 hover:bg-pink-500/15 hover:text-pink-200'}" %>
                <%= link_to t("nav.messages"), conversations_path, class: "block rounded-2xl px-4 py-3 font-black #{controller_name == 'conversations' ? 'bg-white text-slate-950' : 'text-white/80 hover:bg-pink-500/15 hover:text-pink-200'}" %>

                <% if current_user.owner? %>
                  <%= link_to owner_bookings_path, class: "flex items-center justify-between gap-3 rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200" do %>
                    <span><%= t("nav.booking_requests") %></span>
                    <% if @owner_pending_bookings_count.to_i.positive? %>
                      <span class="min-w-5 h-5 px-1 rounded-full bg-pink-500 text-white text-[10px] flex items-center justify-center">
                        <%= @owner_pending_bookings_count %>
                      </span>
                    <% end %>
                  <% end %>

                  <%= link_to t("nav.list_item"), owner_products_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200" %>
                <% end %>

                <% if current_user.admin? %>
                  <%= link_to t("admin.title"), admin_root_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200" %>
                <% end %>

                <%= link_to t("nav.profile"), edit_user_registration_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200" %>

                <div class="my-2 h-px bg-white/10"></div>

                <div class="px-2 py-1">
                  <div class="flex items-center gap-1 rounded-full bg-white/10 p-1 text-sm font-black">
                    <%= link_to "EN", locale_url(:en), class: "flex-1 text-center px-3 py-2 rounded-full transition #{I18n.locale == :en ? 'bg-white text-slate-950 shadow-sm' : 'text-white/50'}" %>
                    <%= link_to "VI", locale_url(:vi), class: "flex-1 text-center px-3 py-2 rounded-full transition #{I18n.locale == :vi ? 'bg-white text-slate-950 shadow-sm' : 'text-white/50'}" %>
                  </div>
                </div>

                <div class="my-2 h-px bg-white/10"></div>

                <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "w-full rounded-2xl px-4 py-3 text-left font-black text-rose-300 hover:bg-rose-500/15 transition cursor-pointer" %>
              <% else %>
                <div class="my-2 h-px bg-white/10"></div>
                <%= link_to t("nav.sign_in"), new_user_session_path, class: "block rounded-2xl px-4 py-3 font-black text-white/80 hover:bg-pink-500/15 hover:text-pink-200" %>
                <%= link_to t("nav.sign_up"), new_user_registration_path, class: "block rounded-2xl px-4 py-3 font-black bg-gradient-to-r from-pink-500 to-orange-400 text-white" %>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    </nav>
    <% end %>

    <% unless content_for?(:auth_immersive) %>
      <% if notice %>
        <div class="max-w-7xl mx-auto px-5 mt-5">
          <div class="rounded-2xl border border-emerald-300/30 bg-emerald-500/15 px-5 py-4 font-semibold text-emerald-100 backdrop-blur">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="max-w-7xl mx-auto px-5 mt-5">
          <div class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-5 py-4 font-semibold text-rose-100 backdrop-blur">
            <%= alert %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= yield %>
  </body>
</html>
