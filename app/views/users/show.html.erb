<% full_location = [@user.ward, @user.district, @user.city].compact_blank.join(", ") %>
<% contact_address = [@user.address, @user.ward, @user.district, @user.city].compact_blank.join(", ") %>
<% social_links = {
  "Facebook" => @user.facebook_url,
  "Instagram" => @user.instagram_url,
  "TikTok" => @user.tiktok_url,
  "Zalo" => @user.zalo_url,
  "Website" => @user.website_url
} %>

<section class="max-w-7xl mx-auto px-5 py-10">
  <div class="grid lg:grid-cols-[360px_1fr] gap-8 items-start">
    <aside class="bg-white rounded-[2.5rem] p-6 shadow-sm border border-orange-100 lg:sticky lg:top-28">
      <div class="w-28 h-28 rounded-[2rem] overflow-hidden bg-gradient-to-br from-pink-500 to-orange-400 text-white flex items-center justify-center text-4xl font-black shadow-lg shadow-pink-100">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "w-full h-full object-cover" %>
        <% else %>
          <%= @user.full_name.to_s.first.presence || "U" %>
        <% end %>
      </div>

      <h1 class="mt-5 text-3xl font-black"><%= @user.full_name.presence || t("profiles.member") %></h1>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="px-3 py-1 rounded-full bg-pink-50 text-pink-600 text-xs font-black uppercase"><%= @user.role %></span>
        <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-black uppercase"><%= @user.status %></span>
      </div>

      <div class="mt-6 space-y-4">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-500 font-bold"><%= t("profiles.location") %></p>
          <p class="mt-1 font-black"><%= full_location.presence || "-" %></p>
        </div>

        <% if @shared_booking.present? || current_user == @user %>
          <div class="rounded-2xl bg-pink-50 p-4">
            <p class="text-sm text-pink-600 font-bold"><%= t("profiles.verified_contact") %></p>
            <p class="mt-2 font-black"><%= @user.phone.presence || "-" %></p>
            <p class="mt-1 text-sm text-slate-600 break-all"><%= @user.email.presence || "-" %></p>
            <p class="mt-2 text-sm text-slate-600"><%= contact_address.presence || "-" %></p>
          </div>
        <% else %>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm text-slate-500 font-bold"><%= t("profiles.private_contact") %></p>
            <p class="mt-1 text-sm text-slate-500"><%= t("profiles.private_contact_hint") %></p>
          </div>
        <% end %>
      </div>
    </aside>

    <div class="space-y-6">
      <div class="bg-slate-950 text-white rounded-[2.5rem] p-6 md:p-8 shadow-xl shadow-slate-200">
        <p class="text-pink-300 font-black uppercase tracking-wide"><%= t("profiles.public_profile") %></p>
        <h2 class="mt-3 text-4xl md:text-5xl font-black tracking-tight">
          <%= t("profiles.heading", name: @user.full_name.presence || t("profiles.member")) %>
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl"><%= t("profiles.subtitle") %></p>

        <div class="mt-6 grid sm:grid-cols-3 gap-3">
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black"><%= @user.products.active.count %></p>
            <p class="text-xs text-slate-400 font-bold uppercase"><%= t("profiles.active_listings") %></p>
          </div>

          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black"><%= @user.owner_bookings.where(status: "completed").count %></p>
            <p class="text-xs text-slate-400 font-bold uppercase"><%= t("profiles.completed_owner_orders") %></p>
          </div>

          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black"><%= @user.rentals.where(status: "completed").count %></p>
            <p class="text-xs text-slate-400 font-bold uppercase"><%= t("profiles.completed_rentals") %></p>
          </div>
        </div>
      </div>

      <section class="bg-white rounded-[2rem] p-6 shadow-sm border border-orange-100">
        <h3 class="text-xl font-black"><%= t("profile.social_info") %></h3>
        <p class="mt-2 text-sm text-slate-500"><%= t("profiles.social_hint") %></p>

        <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% social_links.each do |label, value| %>
            <div class="rounded-2xl bg-slate-50 p-4">
              <p class="text-sm text-slate-500 font-bold"><%= label %></p>
              <% if value.present? %>
                <%= link_to value, value, target: "_blank", rel: "noopener", class: "mt-1 block font-black text-pink-600 break-all" %>
              <% else %>
                <p class="mt-1 font-black">-</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <% if @products.any? %>
        <section>
          <div class="flex items-end justify-between gap-4 mb-5">
            <div>
              <h3 class="text-2xl font-black"><%= t("profiles.listings_by_user", name: @user.full_name.presence || t("profiles.member")) %></h3>
              <p class="mt-1 text-slate-500"><%= t("profiles.listings_hint") %></p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5">
            <% @products.each do |product| %>
              <%= render "products/product_card", product: product %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</section>
