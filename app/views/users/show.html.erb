<% full_location = [@user.ward, @user.district, @user.city].compact_blank.join(", ") %>
<% contact_address = [@user.address, @user.ward, @user.district, @user.city].compact_blank.join(", ") %>
<% social_links = {
  "Facebook" => @user.facebook_url,
  "Instagram" => @user.instagram_url,
  "TikTok" => @user.tiktok_url,
  "Zalo" => @user.zalo_url,
  "Website" => @user.website_url
} %>

<section class="wearly-page">
  <div class="grid items-start gap-8 lg:grid-cols-[360px_1fr]">
    <aside class="wearly-panel sticky top-28 p-6 lg:top-28">
      <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-[2rem] bg-gradient-to-br from-pink-500 to-orange-400 text-4xl font-black text-white shadow-lg shadow-pink-900/40">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "h-full w-full object-cover" %>
        <% else %>
          <%= @user.full_name.to_s.first.presence || "U" %>
        <% end %>
      </div>

      <h1 class="mt-5 text-3xl font-black text-white"><%= @user.full_name.presence || t("profiles.member") %></h1>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="rounded-full bg-pink-500/15 px-3 py-1 text-xs font-black uppercase text-pink-200"><%= user_role_label(@user.role) %></span>
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase text-white/70"><%= user_status_label(@user.status) %></span>
      </div>

      <% if user_signed_in? && current_user != @user %>
        <div class="mt-5">
          <% if @shared_booking&.chattable? %>
            <%= booking_chat_button(
              @shared_booking,
              viewer: current_user,
              class: "wearly-btn wearly-btn-primary w-full"
            ) %>
            <p class="mt-2 text-xs font-bold text-white/50"><%= t("conversations.chat_about_booking") %></p>
          <% else %>
            <p class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-bold text-white/55">
              <%= t("conversations.chat_unavailable_hint") %>
            </p>
          <% end %>
        </div>
      <% end %>

      <div class="mt-6 space-y-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-sm font-bold text-white/50"><%= t("profiles.location") %></p>
          <p class="mt-1 font-black text-white"><%= full_location.presence || "-" %></p>
        </div>

        <% if @shared_booking.present? || current_user == @user %>
          <div class="rounded-2xl border border-pink-400/20 bg-pink-500/10 p-4">
            <p class="text-sm font-bold text-pink-200"><%= t("profiles.verified_contact") %></p>
            <p class="mt-2 font-black text-white"><%= @user.phone.presence || "-" %></p>
            <p class="mt-1 break-all text-sm text-white/65"><%= @user.email.presence || "-" %></p>
            <p class="mt-2 text-sm text-white/65"><%= contact_address.presence || "-" %></p>
          </div>
        <% else %>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-sm font-bold text-white/50"><%= t("profiles.private_contact") %></p>
            <p class="mt-1 text-sm text-white/55"><%= t("profiles.private_contact_hint") %></p>
          </div>
        <% end %>
      </div>
    </aside>

    <div class="space-y-6">
      <div class="wearly-panel p-6 md:p-8">
        <p class="wearly-eyebrow"><%= t("profiles.public_profile") %></p>
        <h2 class="wearly-title">
          <%= t("profiles.heading", name: @user.full_name.presence || t("profiles.member")) %>
        </h2>
        <p class="wearly-subtitle max-w-2xl"><%= t("profiles.subtitle") %></p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-2xl font-black text-white"><%= @user.products.active.count %></p>
            <p class="text-xs font-bold uppercase text-white/40"><%= t("profiles.active_listings") %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-2xl font-black text-white"><%= @user.owner_bookings.where(status: "completed").count %></p>
            <p class="text-xs font-bold uppercase text-white/40"><%= t("profiles.completed_owner_orders") %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-2xl font-black text-white"><%= @user.rentals.where(status: "completed").count %></p>
            <p class="text-xs font-bold uppercase text-white/40"><%= t("profiles.completed_rentals") %></p>
          </div>
        </div>
      </div>

      <section class="wearly-panel p-6">
        <h3 class="text-xl font-black text-white"><%= t("profile.social_info") %></h3>
        <p class="mt-2 text-sm text-white/55"><%= t("profiles.social_hint") %></p>

        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% social_links.each do |label, value| %>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-sm font-bold text-white/50"><%= label %></p>
              <% if value.present? %>
                <%= link_to value, value, target: "_blank", rel: "noopener", class: "mt-1 block break-all font-black text-pink-200 hover:text-white" %>
              <% else %>
                <p class="mt-1 font-black text-white">-</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <% if @products.any? %>
        <section>
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h3 class="text-2xl font-black text-white"><%= t("profiles.listings_by_user", name: @user.full_name.presence || t("profiles.member")) %></h3>
              <p class="mt-1 text-white/55"><%= t("profiles.listings_hint") %></p>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
            <% @products.each do |product| %>
              <%= render "products/product_card", product: product %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</section>
