<section class="wearly-page">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="wearly-eyebrow"><%= t("conversations.title") %></p>
      <h1 class="wearly-title"><%= t("conversations.index_title") %></h1>
      <p class="wearly-subtitle"><%= t("conversations.index_subtitle") %></p>
    </div>

    <%= button_to t("conversations.chat_support"),
      support_conversations_path,
      method: :post,
      class: "wearly-btn wearly-btn-primary cursor-pointer" %>
  </div>

  <% if @conversations.any? %>
    <div class="grid gap-4">
      <% @conversations.each do |conversation| %>
        <% unread = conversation.unread_count_for(current_user) %>
        <%= link_to conversation_path(conversation), class: "wearly-panel block p-5 transition hover:bg-white/[0.09]" do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-pink-200">
                <%= conversation.support? ? t("conversations.kind_support") : t("conversations.kind_booking") %>
              </p>
              <h2 class="mt-2 text-xl font-black text-white"><%= conversation_title(conversation, viewer: current_user) %></h2>
              <p class="mt-2 line-clamp-2 text-sm text-white/55">
                <%= conversation.messages.max_by(&:created_at)&.body.presence || t("conversations.no_messages_yet") %>
              </p>
            </div>
            <div class="shrink-0 text-right">
              <% if unread.positive? %>
                <span class="inline-flex h-7 min-w-7 items-center justify-center rounded-full bg-pink-500 px-2 text-xs font-black text-white"><%= unread %></span>
              <% end %>
              <p class="mt-2 text-xs font-bold text-white/40">
                <%= l(conversation.last_message_at || conversation.created_at, format: :short) %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="wearly-panel p-10 text-center">
      <h2 class="text-3xl font-black text-white"><%= t("conversations.empty_title") %></h2>
      <p class="mt-2 text-white/55"><%= t("conversations.empty_subtitle") %></p>
      <%= button_to t("conversations.chat_support"),
        support_conversations_path,
        method: :post,
        class: "wearly-btn wearly-btn-primary mt-6 inline-flex cursor-pointer" %>
    </div>
  <% end %>
</section>
