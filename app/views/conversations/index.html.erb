<section class="max-w-7xl mx-auto px-5 py-10">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-pink-100 text-pink-700 text-sm font-black">
        💬 <%= t("conversations.title") %>
      </div>
      <h1 class="mt-4 text-4xl font-black tracking-tight"><%= t("conversations.index_title") %></h1>
      <p class="mt-2 text-slate-500"><%= t("conversations.index_subtitle") %></p>
    </div>

    <%= button_to t("conversations.chat_support"),
      support_conversations_path,
      method: :post,
      class: "px-6 py-3 rounded-full bg-slate-950 text-white font-black" %>
  </div>

  <% if @conversations.any? %>
    <div class="grid gap-4">
      <% @conversations.each do |conversation| %>
        <% unread = conversation.unread_count_for(current_user) %>
        <%= link_to conversation_path(conversation), class: "block bg-white rounded-[2rem] border border-orange-100 p-5 shadow-sm hover:shadow-md transition" do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-pink-600">
                <%= conversation.support? ? t("conversations.kind_support") : t("conversations.kind_booking") %>
              </p>
              <h2 class="mt-2 text-xl font-black"><%= conversation_title(conversation, viewer: current_user) %></h2>
              <p class="mt-2 text-sm text-slate-500 line-clamp-2">
                <%= conversation.messages.max_by(&:created_at)&.body.presence || t("conversations.no_messages_yet") %>
              </p>
            </div>
            <div class="text-right shrink-0">
              <% if unread.positive? %>
                <span class="inline-flex min-w-7 h-7 items-center justify-center rounded-full bg-pink-500 px-2 text-xs font-black text-white"><%= unread %></span>
              <% end %>
              <p class="mt-2 text-xs text-slate-400 font-bold">
                <%= l(conversation.last_message_at || conversation.created_at, format: :short) %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-[2.5rem] p-10 text-center shadow-sm border border-orange-100">
      <h2 class="text-3xl font-black"><%= t("conversations.empty_title") %></h2>
      <p class="mt-2 text-slate-500"><%= t("conversations.empty_subtitle") %></p>
      <%= button_to t("conversations.chat_support"),
        support_conversations_path,
        method: :post,
        class: "inline-flex mt-6 px-6 py-3 rounded-full bg-slate-950 text-white font-black" %>
    </div>
  <% end %>
</section>
